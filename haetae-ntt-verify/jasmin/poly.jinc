  while (block < 64)
  {
    zeta = zetasp[64 + block];
    start = block;
    start <<= 2;
    j = 0;
    while (j < 2)
    {
      idx = j;
      idx += start;
      s = rp[idx];
      offset = idx;
      offset += 2;
      coeff = rp[offset];
      t = __fqmul(zeta, coeff);
      coeff = s;
      coeff -= t;
      rp[offset] = coeff;
      s += t;
      rp[idx] = s;
