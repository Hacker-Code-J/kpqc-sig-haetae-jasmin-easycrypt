  zetasp = jzetas_inv;
  block = 0;
  while (block < 8)
  {
    zeta = zetasp[240 + block];
    start = block;
    start <<= 5;
    j = 0;
    while (j < 16)
    {
      idx = j;
      idx += start;
      t = rp[idx];
      offset = idx;
      offset += 16;
      coeff = rp[offset];
      s = t;
      s += coeff;
      rp[idx] = s;
      t -= coeff;
      t = __fqmul(zeta, t);
