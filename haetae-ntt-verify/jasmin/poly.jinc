  while (block < 32)
  {
    zeta = zetasp[32 + block];
    start = block;
    start <<= 3;
    j = 0;
    while (j < 4)
    {
      idx = j;
      idx += start;
      s = rp[idx];
      offset = idx;
      offset += 4;
      coeff = rp[offset];
      t = __fqmul(zeta, coeff);
      coeff = s;
      coeff -= t;
      rp[offset] = coeff;
      s += t;
      rp[idx] = s;
      j += 1;
    }
    block += 1;
  }
  return rp;
}

fn _poly_ntt_stage_2(reg mut ptr u32[HAETAE_N] rp) -> reg ptr u32[HAETAE_N]
