fn _poly_invntt_stage_32(reg mut ptr u32[HAETAE_N] rp) -> reg ptr u32[HAETAE_N]
{
  reg ptr u32[256] zetasp;
  reg ui64 block;
  reg ui64 j;
  reg ui64 start;
  reg ui64 idx;
  reg ui64 offset;
  reg u32 zeta t s coeff;

  zetasp = jzetas_inv;
  block = 0;
  while (block < 4)
  {
    zeta = zetasp[248 + block];
    start = block;
    start <<= 6;
    j = 0;
    while (j < 32)
    {
      idx = j;
      idx += start;
      t = rp[idx];
      offset = idx;
      offset += 32;
      coeff = rp[offset];
      s = t;
      s += coeff;
      rp[idx] = s;
      t -= coeff;
      t = __fqmul(zeta, t);
      rp[offset] = t;
      j += 1;
    }
    block += 1;
  }
  return rp;
}

fn _poly_invntt_stage_64(reg mut ptr u32[HAETAE_N] rp) -> reg ptr u32[HAETAE_N]
{
  reg ptr u32[256] zetasp;
  reg ui64 block;
  reg ui64 j;
  reg ui64 start;
  reg ui64 idx;
  reg ui64 offset;
  reg u32 zeta t s coeff;

  zetasp = jzetas_inv;
  block = 0;
  while (block < 2)
  {
    zeta = zetasp[252 + block];
    start = block;
    start <<= 7;
    j = 0;
    while (j < 64)
    {
      idx = j;
      idx += start;
      t = rp[idx];
      offset = idx;
      offset += 64;
      coeff = rp[offset];
      s = t;
      s += coeff;
      rp[idx] = s;
      t -= coeff;
      t = __fqmul(zeta, t);
      rp[offset] = t;
      j += 1;
    }
    block += 1;
  }
  return rp;
}

fn _poly_invntt_stage_128(reg mut ptr u32[HAETAE_N] rp) -> reg ptr u32[HAETAE_N]
{
  reg ptr u32[256] zetasp;
  reg ui64 block;
  reg ui64 j;
  reg ui64 start;
  reg ui64 idx;
  reg ui64 offset;
  reg u32 zeta t s coeff;

  zetasp = jzetas_inv;
  block = 0;
  while (block < 1)
  {
    zeta = zetasp[254 + block];
    start = block;
    start <<= 8;
    j = 0;
    while (j < 128)
    {
      idx = j;
      idx += start;
      t = rp[idx];
      offset = idx;
      offset += 128;
      coeff = rp[offset];
      s = t;
      s += coeff;
      rp[idx] = s;
      t -= coeff;
      t = __fqmul(zeta, t);
      rp[offset] = t;
      j += 1;
    }
    block += 1;
  }
  return rp;
}

fn _poly_invntt_scale(reg mut ptr u32[HAETAE_N] rp) -> reg ptr u32[HAETAE_N]
{
  reg ptr u32[256] zetasp;
  reg ui64 j;
  reg u32 zeta coeff t;

  zetasp = jzetas_inv;
  zeta = zetasp[255];
  j = 0;
  while (j < HAETAE_N)
  {
    coeff = rp[j];
    t = __fqmul(zeta, coeff);
    rp[j] = t;
    j += 1;
  }
  return rp;
}

/* Inverse NTT multiplied by Montgomery factor 2^32 (in-place).
 * Mirrors C invntt_tomont(): 8 inverse butterfly layers + final scaling by f. */
fn _poly_invntt(reg mut ptr u32[HAETAE_N] rp) -> reg ptr u32[HAETAE_N]
{
  rp = _poly_invntt_stage_1(rp);
  rp = _poly_invntt_stage_2(rp);
  rp = _poly_invntt_stage_4(rp);
  rp = _poly_invntt_stage_8(rp);
  rp = _poly_invntt_stage_16(rp);
  rp = _poly_invntt_stage_32(rp);
  rp = _poly_invntt_stage_64(rp);
  rp = _poly_invntt_stage_128(rp);
  rp = _poly_invntt_scale(rp);

  return rp;
}

/* Pointwise multiplication in NTT domain: r[i] = montgomery_reduce(a[i]*b[i]) */
fn _poly_basemul(reg mut ptr u32[HAETAE_N] rp,
                 reg const ptr u32[HAETAE_N] ap bp) -> reg ptr u32[HAETAE_N]
{
  reg ui64 i;
  reg u32 a b r;

  i = 0;
  while (i < HAETAE_N)
  {
    a = ap[i];
    b = bp[i];
    r = __fqmul(a, b);
    rp[i] = r;
    i += 1;
  }
  return rp;
}
