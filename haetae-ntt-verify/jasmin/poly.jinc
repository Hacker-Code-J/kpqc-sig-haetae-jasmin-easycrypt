require "params.jinc"
require "reduce.jinc"
require "zetas.jinc"

fn _poly_ntt_stage_128(reg mut ptr u32[HAETAE_N] rp) -> reg ptr u32[HAETAE_N]
{
  reg ptr u32[256] zetasp;
  reg ui64 block;
  reg ui64 j;
  reg ui64 start;
  reg ui64 idx;
  reg ui64 offset;
  reg u32 zeta t s coeff;

  zetasp = jzetas;
  block = 0;
  while (block < 1)
  {
    zeta = zetasp[1 + block];
    start = block;
    start <<= 8;
    j = 0;
    while (j < 128)
    {
      idx = j;
      idx += start;
      s = rp[idx];
      offset = idx;
      offset += 128;
      coeff = rp[offset];
      t = __fqmul(zeta, coeff);
      coeff = s;
      coeff -= t;
      rp[offset] = coeff;
      s += t;
      rp[idx] = s;
      j += 1;
    }
    block += 1;
  }
  return rp;
}

fn _poly_ntt_stage_64(reg mut ptr u32[HAETAE_N] rp) -> reg ptr u32[HAETAE_N]
{
  reg ptr u32[256] zetasp;
  reg ui64 block;
  reg ui64 j;
  reg ui64 start;
  reg ui64 idx;
  reg ui64 offset;
  reg u32 zeta t s coeff;

  zetasp = jzetas;
  block = 0;
  while (block < 2)
  {
    zeta = zetasp[2 + block];
    start = block;
    start <<= 7;
    j = 0;
    while (j < 64)
    {
      idx = j;
      idx += start;
      s = rp[idx];
      offset = idx;
      offset += 64;
      coeff = rp[offset];
      t = __fqmul(zeta, coeff);
      coeff = s;
      coeff -= t;
      rp[offset] = coeff;
      s += t;
      rp[idx] = s;
      j += 1;
    }
    block += 1;
  }
  return rp;
}

