  reg ui64 idx;
  reg ui64 offset;
  reg u32 zeta t s coeff;

  zetasp = jzetas_inv;
  block = 0;
  while (block < 32)
  {
    zeta = zetasp[192 + block];
    start = block;
    start <<= 3;
    j = 0;
    while (j < 4)
    {
      idx = j;
      idx += start;
      t = rp[idx];
      offset = idx;
      offset += 4;
      coeff = rp[offset];
      s = t;
      s += coeff;
      rp[idx] = s;
      t -= coeff;
      t = __fqmul(zeta, t);
      rp[offset] = t;
      j += 1;
    }
    block += 1;
  }
  return rp;
}

