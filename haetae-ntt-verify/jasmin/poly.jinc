fn _poly_ntt_stage_1(reg mut ptr u32[HAETAE_N] rp) -> reg ptr u32[HAETAE_N]
{
  reg ptr u32[256] zetasp;
  reg ui64 block;
  reg ui64 j;
  reg ui64 start;
  reg ui64 idx;
  reg ui64 offset;
  reg u32 zeta t s coeff;

  zetasp = jzetas;
  block = 0;
  while (block < 128)
  {
    zeta = zetasp[128 + block];
    start = block;
    start <<= 1;
    j = 0;
    while (j < 1)
    {
      idx = j;
      idx += start;
      s = rp[idx];
      offset = idx;
      offset += 1;
      coeff = rp[offset];
      t = __fqmul(zeta, coeff);
      coeff = s;
      coeff -= t;
      rp[offset] = coeff;
      s += t;
      rp[idx] = s;
      j += 1;
    }
    block += 1;
  }
  return rp;
}

/* Forward NTT (in-place, bit-reversed output).
 * Mirrors C ntt(): 8 butterfly layers, no reduction between steps.
 * Coefficients are int32_t stored as u32. */
fn _poly_ntt(reg mut ptr u32[HAETAE_N] rp) -> reg ptr u32[HAETAE_N]
{
  rp = _poly_ntt_stage_128(rp);
  rp = _poly_ntt_stage_64(rp);
  rp = _poly_ntt_stage_32(rp);
  rp = _poly_ntt_stage_16(rp);
  rp = _poly_ntt_stage_8(rp);
  rp = _poly_ntt_stage_4(rp);
  rp = _poly_ntt_stage_2(rp);
  rp = _poly_ntt_stage_1(rp);
  return rp;
}

fn _poly_invntt_stage_1(reg mut ptr u32[HAETAE_N] rp) -> reg ptr u32[HAETAE_N]
{
  reg ptr u32[256] zetasp;
  reg ui64 block;
  reg ui64 j;
  reg ui64 start;
  reg ui64 idx;
  reg ui64 offset;
  reg u32 zeta t s coeff;

  zetasp = jzetas_inv;
  block = 0;
  while (block < 128)
  {
    zeta = zetasp[0 + block];
    start = block;
    start <<= 1;
    j = 0;
    while (j < 1)
    {
      idx = j;
      idx += start;
      t = rp[idx];
      offset = idx;
      offset += 1;
      coeff = rp[offset];
      s = t;
      s += coeff;
      rp[idx] = s;
      t -= coeff;
      t = __fqmul(zeta, t);
      rp[offset] = t;
      j += 1;
    }
    block += 1;
  }
  return rp;
}

fn _poly_invntt_stage_2(reg mut ptr u32[HAETAE_N] rp) -> reg ptr u32[HAETAE_N]
{
  reg ptr u32[256] zetasp;
  reg ui64 block;
  reg ui64 j;
  reg ui64 start;
  reg ui64 idx;
  reg ui64 offset;
  reg u32 zeta t s coeff;

  zetasp = jzetas_inv;
  block = 0;
  while (block < 64)
  {
    zeta = zetasp[128 + block];
    start = block;
    start <<= 2;
    j = 0;
    while (j < 2)
    {
      idx = j;
      idx += start;
      t = rp[idx];
      offset = idx;
      offset += 2;
      coeff = rp[offset];
      s = t;
      s += coeff;
      rp[idx] = s;
      t -= coeff;
      t = __fqmul(zeta, t);
      rp[offset] = t;
      j += 1;
    }
    block += 1;
  }
  return rp;
}

fn _poly_invntt_stage_4(reg mut ptr u32[HAETAE_N] rp) -> reg ptr u32[HAETAE_N]
{
  reg ptr u32[256] zetasp;
