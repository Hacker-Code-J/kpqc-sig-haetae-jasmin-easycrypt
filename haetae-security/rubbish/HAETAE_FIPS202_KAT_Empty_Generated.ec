rewrite (_ : 26 = 25 + 1) 1:/# exprS //.
rewrite (_ : 25 = 24 + 1) 1:/# exprS //.
rewrite (_ : 24 = 23 + 1) 1:/# exprS //.
rewrite (_ : 23 = 22 + 1) 1:/# exprS //.
rewrite (_ : 22 = 21 + 1) 1:/# exprS //.
rewrite (_ : 21 = 20 + 1) 1:/# exprS //.
rewrite (_ : 20 = 19 + 1) 1:/# exprS //.
rewrite (_ : 19 = 18 + 1) 1:/# exprS //.
rewrite (_ : 18 = 17 + 1) 1:/# exprS //.
rewrite (_ : 17 = 16 + 1) 1:/# exprS //.
rewrite (_ : 16 = 15 + 1) 1:/# exprS //.
rewrite (_ : 15 = 14 + 1) 1:/# exprS //.
rewrite (_ : 14 = 13 + 1) 1:/# exprS //.
rewrite (_ : 13 = 12 + 1) 1:/# exprS //.
rewrite (_ : 12 = 11 + 1) 1:/# exprS //.
rewrite (_ : 11 = 10 + 1) 1:/# exprS //.
rewrite (_ : 10 = 9 + 1) 1:/# exprS //.
rewrite (_ : 9 = 8 + 1) 1:/# exprS //.
rewrite (_ : 8 = 7 + 1) 1:/# exprS //.
rewrite (_ : 7 = 6 + 1) 1:/# exprS //.
