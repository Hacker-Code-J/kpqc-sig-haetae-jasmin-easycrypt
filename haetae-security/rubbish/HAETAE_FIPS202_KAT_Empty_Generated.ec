lemma empty_round24_output_byte_from_bitsE
  i b0 b1 b2 b3 b4 b5 b6 b7 :
  0 <= i < 64 =>
  keccak_lane_bit
    (nth keccak_lane_zero shake256_empty_round24_lanes_cert (i %/ 8))
    (8 * (i %% 8)) = b0 =>
  keccak_lane_bit
    (nth keccak_lane_zero shake256_empty_round24_lanes_cert (i %/ 8))
    (8 * (i %% 8) + 1) = b1 =>
  keccak_lane_bit
    (nth keccak_lane_zero shake256_empty_round24_lanes_cert (i %/ 8))
    (8 * (i %% 8) + 2) = b2 =>
  keccak_lane_bit
    (nth keccak_lane_zero shake256_empty_round24_lanes_cert (i %/ 8))
    (8 * (i %% 8) + 3) = b3 =>
  keccak_lane_bit
    (nth keccak_lane_zero shake256_empty_round24_lanes_cert (i %/ 8))
    (8 * (i %% 8) + 4) = b4 =>
  keccak_lane_bit
    (nth keccak_lane_zero shake256_empty_round24_lanes_cert (i %/ 8))
    (8 * (i %% 8) + 5) = b5 =>
  keccak_lane_bit
    (nth keccak_lane_zero shake256_empty_round24_lanes_cert (i %/ 8))
    (8 * (i %% 8) + 6) = b6 =>
  keccak_lane_bit
    (nth keccak_lane_zero shake256_empty_round24_lanes_cert (i %/ 8))
    (8 * (i %% 8) + 7) = b7 =>
  nth 0 shake256_empty_64_certificate_output i =
  (if b0 then 1 else 0) +
  ((if b1 then 2 else 0) +
  ((if b2 then 4 else 0) +
  ((if b3 then 8 else 0) +
  ((if b4 then 16 else 0) +
  ((if b5 then 32 else 0) +
  ((if b6 then 64 else 0) +
   (if b7 then 128 else 0))))))).
proof.
move=> i_range h0 h1 h2 h3 h4 h5 h6 h7.
rewrite /shake256_empty_64_certificate_output nth_mkseq; first by smt().
rewrite /shake256_empty_round24_bytes_cert /=.
