theory HAETAE_FIPS202_KAT_Empty_Generated.

import HAETAE_FIPS202_KAT_Certificates.
import HAETAE_FIPS202_TestVectors.
import HAETAE_Keccak1600.

lemma empty_generated_pow2_1E :
  2 ^ 1 = 2.
proof. by rewrite expr1. qed.

lemma empty_generated_pow2_2E :
  2 ^ 2 = 4.
proof. by rewrite expr2. qed.

lemma empty_generated_pow2_3E :
  2 ^ 3 = 8.
proof.
rewrite (_ : 3 = 2 + 1) 1:/# exprS //.
by rewrite empty_generated_pow2_2E.
qed.

lemma empty_generated_pow2_4E :
  2 ^ 4 = 16.
proof.
rewrite (_ : 4 = 3 + 1) 1:/# exprS //.
by rewrite empty_generated_pow2_3E.
qed.

lemma empty_generated_pow2_5E :
  2 ^ 5 = 32.
proof.
rewrite (_ : 5 = 4 + 1) 1:/# exprS //.
by rewrite empty_generated_pow2_4E.
qed.

lemma empty_generated_pow2_6E :
  2 ^ 6 = 64.
proof.
rewrite (_ : 6 = 5 + 1) 1:/# exprS //.
by rewrite empty_generated_pow2_5E.
qed.

lemma empty_generated_pow2_7E :
  2 ^ 7 = 128.
proof.
rewrite (_ : 7 = 6 + 1) 1:/# exprS //.
by rewrite empty_generated_pow2_6E.
qed.

lemma empty_generated_pow2_64E :
  2 ^ 64 = 18446744073709551616.
proof.
rewrite (_ : 64 = 63 + 1) 1:/# exprS //.
rewrite (_ : 63 = 62 + 1) 1:/# exprS //.
rewrite (_ : 62 = 61 + 1) 1:/# exprS //.
