rewrite (_ : 3 = 2 + 1) 1:/# exprS //.
rewrite (_ : 2 = 1 + 1) 1:/# exprS //.
rewrite (_ : 1 = 0 + 1) 1:/# exprS //.
by rewrite expr0.
qed.

lemma empty_round01_lane00_bit00 :
  keccak_lane_bit
    (nth keccak_lane_zero shake256_empty_round01_lanes_cert 0)
    0 = true.
proof.
rewrite /shake256_empty_round01_lanes_cert.
rewrite keccak_round_bitE; 1,2: by smt().
rewrite /= keccak_chi_bit_indexE; 1,2: by smt().
rewrite /= !keccak_rho_pi_bit_indexE; 1..6: by smt().
rewrite /= !keccak_theta_bit_indexE; 1..6: by smt().
rewrite /= !keccak_theta_d_bit_indexE;
  1..3: by rewrite /keccak_lane_bits /keccak_rho_offsets
                   /keccak_lane_index; smt().
rewrite /keccak_theta_d_bit_index_value /keccak_theta_c_bit_index_value.
rewrite /= /shake256_empty_round00_lanes_cert.
rewrite !keccak_lanes_of_bytes_bitE;
  1..66: by rewrite /keccak_state_lanes /keccak_lane_bits
                   /keccak_lane_index /keccak_rho_offsets; smt().
rewrite /shake256_empty_padded_state_cert
        /kat_round_constant
        /keccak_round_constants
        /keccak_lane_of_int
        /keccak_lane_bit
        /keccak_byte_bit
        /keccak_byte_norm
        /keccak_lane_bits.
rewrite /= !nth_mkseq;
  1..34: by rewrite /keccak_lane_index /keccak_rho_offsets; smt().
rewrite /keccak_lane_index /keccak_rho_offsets /=.
rewrite empty_generated_pow2_7E.
rewrite /keccak_word_bit /keccak_word_norm /keccak_lane_bits /=.
rewrite (: 1 %% 2 ^ 64 = 1); first by rewrite pmod_small; smt().
by smt().
qed.

lemma empty_round24_output_byte00_from_bits :
  keccak_lane_bit
    (nth keccak_lane_zero shake256_empty_round24_lanes_cert 0)
    0 = false =>
  keccak_lane_bit
    (nth keccak_lane_zero shake256_empty_round24_lanes_cert 0)
    1 = true =>
  keccak_lane_bit
    (nth keccak_lane_zero shake256_empty_round24_lanes_cert 0)
    2 = true =>
  keccak_lane_bit
    (nth keccak_lane_zero shake256_empty_round24_lanes_cert 0)
    3 = false =>
  keccak_lane_bit
    (nth keccak_lane_zero shake256_empty_round24_lanes_cert 0)
    4 = false =>
  keccak_lane_bit
    (nth keccak_lane_zero shake256_empty_round24_lanes_cert 0)
    5 = false =>
  keccak_lane_bit
    (nth keccak_lane_zero shake256_empty_round24_lanes_cert 0)
    6 = true =>
  keccak_lane_bit
    (nth keccak_lane_zero shake256_empty_round24_lanes_cert 0)
    7 = false =>
  nth 0 shake256_empty_64_certificate_output 0 =
  nth 0 shake256_empty_64_expected 0.
proof.
move=> b0 b1 b2 b3 b4 b5 b6 b7.
rewrite /shake256_empty_64_certificate_output nth_mkseq; first by smt().
rewrite /shake256_empty_round24_bytes_cert.
rewrite /=.
rewrite keccak_bytes_of_lanes_byteE; first by rewrite /keccak_state_bytes; smt().
rewrite (: 0 %/ 8 = 0) 1:/# (: 0 %% 8 = 0) 1:/#.
rewrite (keccak_lane_to_byte_70E
           (nth keccak_lane_zero shake256_empty_round24_lanes_cert 0) 0);
  1..8: by smt().
by rewrite /shake256_empty_64_expected.
qed.

