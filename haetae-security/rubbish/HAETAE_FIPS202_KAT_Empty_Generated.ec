rewrite (_ : 37 = 36 + 1) 1:/# exprS //.
rewrite (_ : 36 = 35 + 1) 1:/# exprS //.
rewrite (_ : 35 = 34 + 1) 1:/# exprS //.
rewrite (_ : 34 = 33 + 1) 1:/# exprS //.
rewrite (_ : 33 = 32 + 1) 1:/# exprS //.
