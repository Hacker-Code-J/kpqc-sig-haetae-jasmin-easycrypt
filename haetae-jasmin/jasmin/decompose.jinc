fn _poly_decompose_vk(reg mut ptr u32[HAETAE_N] lowp,
                      reg mut ptr u32[HAETAE_N] highp) -> reg ptr u32[HAETAE_N],
                                                                reg ptr u32[HAETAE_N]
{
  reg ui64 i;
  reg u32 a a0 tmp a1;

  i = 0;
  while (i < HAETAE_N)
  {
    a = highp[i];
    a0 = a;
    a0 &= 1;
    tmp = a;
    tmp >>s= 1;
    tmp &= a0;
    tmp <<= 1;
    a0 -= tmp;
    lowp[i] = a0;

    a1 = a;
    a1 -= a0;
    a1 >>s= 1;
    highp[i] = a1;

    i += 1;
  }

  return lowp, highp;
}

fn _polyvec_decompose_vk(reg mut ptr u32[2048] lowp,
                         reg mut ptr u32[2048] highp,
                         reg u64 count) -> reg ptr u32[2048],
                                           reg ptr u32[2048]
{
  reg u64 i;
  reg u32 a a0 tmp a1;

  i = 0;
  while (i < count)
  {
    a = highp[i];
    a0 = a;
    a0 &= 1;
    tmp = a;
    tmp >>s= 1;
    tmp &= a0;
    tmp <<= 1;
    a0 -= tmp;
    lowp[i] = a0;

    a1 = a;
    a1 -= a0;
    a1 >>s= 1;
    highp[i] = a1;

    i += 1;
  }

  return lowp, highp;
}
