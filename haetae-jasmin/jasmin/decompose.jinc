fn _polyvec_highbits_hint_m5(reg mut ptr u32[2048] rp,
                             reg const ptr u32[2048] ap,
                             reg u64 count) -> reg ptr u32[2048]
{
  reg u64 i;
  reg u32 hb edge sub;

  i = 0;
  while (i < count)
  {
    hb = ap[i];
    hb += HAETAE_HINT_HALF_ALPHA_M5;
    hb >>s= HAETAE_HINT_LOG_ALPHA_M5;
    edge = HAETAE_HINT_BOUND_M5;
    edge -= hb;
    edge -= 1;
    edge >>s= 31;
