fn __copy_encoded_suffix(reg mut ptr u8[2048] outp,
                         reg const ptr u8[2048] encp,
                         reg u64 off,
                         reg u64 size) -> reg ptr u8[2048]
{
  reg u64 i idx;
  reg u8 b;

  i = 0;
  while (i < size)
  {
    idx = off;
    idx += i;
    b = encp[idx];
    outp[i] = b;
    i += 1;
  }

  return outp;
}

fn _encode_h_full(reg mut ptr u8[2048] outp,
                  reg const ptr u32[2048] hp,
                  reg const ptr u32[132] esymsp,
                  reg u64 count,
                  reg u64 mh,
                  reg u64 offset) -> reg ptr u8[2048], reg u64
{
  stack u8[2048] symbols;
  stack u8[2048] encoding;
  stack u64[2] state;
  stack u64[1] bad;
  reg ptr u8[2048] symsp;
  reg ptr u8[2048] encp;
  reg ptr u64[2] statep;
  reg ptr u64[1] badp;
  reg u64 badv off size;
  reg bool b;
  #[msf] reg u64 ms;

  symsp = symbols;
  encp = encoding;
  statep = state;
  badp = bad;

  () = #spill(outp, encp, statep, esymsp, count);
  symsp, badp = _encode_h_prepare(symsp, badp, hp, count, mh, offset);
  () = #unspill(outp, encp, statep, esymsp, count);
  badv = badp[0];
  () = #declassify(badv);
  ms = #init_msf();
  badv = #protect(badv, ms);

  b = badv != 0;
  if (b)
  {
    ms = #update_msf(b, ms);
    size = 0;
  }
  else
  {
    ms = #update_msf(!b, ms);
    () = #spill(outp, count);
    encp, statep = _rans_encode(encp, statep, symsp, esymsp, count);
    () = #unspill(outp, count);
    badv = statep[1];
    () = #declassify(badv);
    ms = #init_msf();
    badv = #protect(badv, ms);

    b = badv != 0;
    if (b)
    {
      ms = #update_msf(b, ms);
      size = 0;
    }
    else
    {
      ms = #update_msf(!b, ms);
      off = statep[0];
      size = count;
      size -= off;
      () = #declassify(off);
      () = #declassify(size);
      ms = #init_msf();
      off = #protect(off, ms);
      size = #protect(size, ms);
      outp = __copy_encoded_suffix(outp, encp, off, size);
    }
  }

  return outp, size;
}

fn _encode_hb_z1_full(reg mut ptr u8[2048] outp,
                      reg const ptr u32[2048] hp,
                      reg const ptr u32[132] esymsp,
                      reg u64 count,
                      reg u64 mhb,
                      reg u64 offset) -> reg ptr u8[2048], reg u64
{
  stack u8[2048] symbols;
  stack u8[2048] encoding;
  stack u64[2] state;
  stack u64[1] bad;
  reg ptr u8[2048] symsp;
  reg ptr u8[2048] encp;
  reg ptr u64[2] statep;
  reg ptr u64[1] badp;
  reg u64 badv off size;
  reg bool b;
  #[msf] reg u64 ms;

  symsp = symbols;
  encp = encoding;
  statep = state;
  badp = bad;

  () = #spill(outp, encp, statep, esymsp, count);
  symsp, badp = _encode_hb_z1_prepare(symsp, badp, hp, count, mhb, offset);
  () = #unspill(outp, encp, statep, esymsp, count);
  badv = badp[0];
  () = #declassify(badv);
  ms = #init_msf();
  badv = #protect(badv, ms);

  b = badv != 0;
  if (b)
  {
    ms = #update_msf(b, ms);
    size = 0;
  }
  else
  {
    ms = #update_msf(!b, ms);
    () = #spill(outp, count);
    encp, statep = _rans_encode(encp, statep, symsp, esymsp, count);
    () = #unspill(outp, count);
    badv = statep[1];
    () = #declassify(badv);
    ms = #init_msf();
    badv = #protect(badv, ms);

    b = badv != 0;
    if (b)
    {
      ms = #update_msf(b, ms);
      size = 0;
    }
    else
    {
      ms = #update_msf(!b, ms);
      off = statep[0];
      size = count;
      size -= off;
      () = #declassify(off);
      () = #declassify(size);
      ms = #init_msf();
      off = #protect(off, ms);
      size = #protect(size, ms);
      outp = __copy_encoded_suffix(outp, encp, off, size);
    }
  }

  return outp, size;
}

fn _decode_h_full(reg mut ptr u32[2048] hp,
                  reg mut ptr u64[1] badp,
                  reg const ptr u8[2048] bufp,
                  reg u64 size_in,
                  reg const ptr u32[512] symbolwp,
                  reg const ptr u32[132] dsymswp,
                  reg u64 count,
                  reg u64 mh,
                  reg u64 offset) -> reg ptr u32[2048],
                                      reg ptr u64[1]
{
  stack u8[2048] symbols;
  stack u64[3] state;
  reg ptr u8[2048] symsp;
  reg ptr u64[3] statep;
  reg u64 bad hcut;
  reg bool b;
  #[msf] reg u64 ms;

  symsp = symbols;
  statep = state;

  statep[0] = count;
  statep[1] = size_in;
  statep[2] = mh;

  () = #spill(hp, badp, count, mh, offset);
  symsp, statep = _rans_decode(symsp, statep, bufp, symbolwp, dsymswp);
  () = #unspill(hp, badp, count, mh, offset);

  bad = statep[1];
  () = #declassify(bad);
  ms = #init_msf();
  bad = #protect(bad, ms);
  b = bad == 0;
  if (b)
  {
    ms = #update_msf(b, ms);
    hcut = mh;
    hcut -= 1;
    hcut >>= 1;
    hp = _decode_h_apply(hp, symsp, count, hcut, offset);
  }
  else
  {
    ms = #update_msf(!b, ms);
  }

  badp[0] = bad;
  return hp, badp;
}

fn _decode_hb_z1_full(reg mut ptr u32[2048] hp,
                      reg mut ptr u64[1] badp,
                      reg const ptr u8[2048] bufp,
                      reg u64 size_in,
                      reg const ptr u32[512] symbolwp,
                      reg const ptr u32[132] dsymswp,
                      reg u64 count,
                      reg u64 mhb,
                      reg u64 offset) -> reg ptr u32[2048],
                                          reg ptr u64[1]
{
  stack u8[2048] symbols;
  stack u64[3] state;
  reg ptr u8[2048] symsp;
  reg ptr u64[3] statep;
  reg u64 bad;
  reg bool b;
  #[msf] reg u64 ms;

  symsp = symbols;
  statep = state;

  statep[0] = count;
  statep[1] = size_in;
  statep[2] = mhb;

  () = #spill(hp, badp, count, offset);
  symsp, statep = _rans_decode(symsp, statep, bufp, symbolwp, dsymswp);
  () = #unspill(hp, badp, count, offset);

  bad = statep[1];
  () = #declassify(bad);
  ms = #init_msf();
  bad = #protect(bad, ms);
  b = bad == 0;
  if (b)
  {
    ms = #update_msf(b, ms);
    hp = _decode_hb_z1_apply(hp, symsp, count, offset);
  }
  else
  {
    ms = #update_msf(!b, ms);
  }

  badp[0] = bad;
  return hp, badp;
}
