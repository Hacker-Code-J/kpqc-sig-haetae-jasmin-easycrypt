require "params.jinc"
require "keccak.jinc"
require "polynomial_sampler.jinc"

#[ct = "ap * public * nonce -> ap"]
export
fn poly_uniform_jazz(reg mut ptr u32[8192] ap,
                     reg ui64 seedp,
                     reg u64 nonce) -> reg ptr u32[8192]
{
  reg u64 base seeda;
  #[msf] reg u64 ms;

  seeda = (64u)seedp;
  () = #declassify(seeda);
  ms = #init_msf();
  ap = #protect_ptr(ap, ms);
  seeda = #protect(seeda, ms);
  nonce = #protect(nonce, ms);
  base = 0;
  ap = _poly_uniform_at_addr(ap, base, seeda, nonce);
  return ap;
}

#[ct = "ap * public * nonce -> ap"]
export
fn poly_uniform_eta_jazz(reg mut ptr u32[8192] ap,
                         reg ui64 seedp,
                         reg u64 nonce) -> reg ptr u32[8192]
{
  reg u64 base seeda;
  #[msf] reg u64 ms;

  seeda = (64u)seedp;
  () = #declassify(seeda);
  ms = #init_msf();
  ap = #protect_ptr(ap, ms);
  seeda = #protect(seeda, ms);
  nonce = #protect(nonce, ms);
  base = 0;
  ap = _poly_uniform_eta_at_addr(ap, base, seeda, nonce);
  return ap;
}
