require "params.jinc"
require "keccak.jinc"
require "polynomial_sampler.jinc"
require "expand.jinc"

#[ct = "vp * public * public * m -> vp"]
export
fn polyveck_expand_vecA_jazz(reg mut ptr u32[8192] vp,
                             reg ui64 seedp,
                             reg u64 k,
                             reg u64 m) -> reg ptr u32[8192]
{
  #[msf] reg u64 ms;

  ms = #init_msf();
  vp = #protect_ptr(vp, ms);
  k = #protect(k, ms);
  m = #protect(m, ms);
  vp = _polyveck_expand_vecA(vp, seedp, k, m);
  return vp;
}

#[ct = "vp * public * nonce * public -> vp"]
export
fn polyvec_expand_eta_jazz(reg mut ptr u32[8192] vp,
                           reg ui64 seedp,
                           reg u64 nonce,
                           reg u64 count) -> reg ptr u32[8192]
{
  #[msf] reg u64 ms;

  ms = #init_msf();
  vp = #protect_ptr(vp, ms);
  nonce = #protect(nonce, ms);
  count = #protect(count, ms);
  vp = _polyvec_expand_eta(vp, seedp, nonce, count);
  return vp;
}

#[ct = "matp * public * public * public -> matp"]
