                              reg ui64 seedp,
                              reg u64 rows,
                              reg u64 cols) -> reg ptr u32[8192]
{
  #[msf] reg u64 ms;

  ms = #init_msf();
  matp = #protect_ptr(matp, ms);
  rows = #protect(rows, ms);
  cols = #protect(cols, ms);
  matp = _polymatkl_expand_matA(matp, seedp, rows, cols);
  return matp;
}

