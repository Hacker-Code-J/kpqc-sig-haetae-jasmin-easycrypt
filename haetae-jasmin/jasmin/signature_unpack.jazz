require "params.jinc"
require "pack.jinc"
require "encoding.jinc"
require "sparse_encoding.jinc"
require "encoding_tables.jinc"
require "signature_unpack.jinc"

#[ct = "cp * lowp * hbzp * hp * public * public -> cp * lowp * hbzp * hp * public"]
export
fn unpack_sig_mode2_full_jazz(reg mut ptr u32[HAETAE_N] cp,
                              reg mut ptr u32[2048] lowp,
                              reg mut ptr u32[2048] hbzp,
                              reg mut ptr u32[2048] hp,
                              reg mut ptr u64[1] badp,
                              reg const ptr u8[2948] sigp)
                              -> reg ptr u32[HAETAE_N],
                                 reg ptr u32[2048],
                                 reg ptr u32[2048],
                                 reg ptr u32[2048],
                                 reg ptr u64[1]
{
  reg ptr u32[512] h_symbolwp hb_symbolwp;
  reg ptr u32[132] h_dsymswp hb_dsymswp;
  #[msf] reg u64 ms;

  h_symbolwp = jmode2_h_symbol_words;
  h_dsymswp = jmode2_h_dsyms_words;
  hb_symbolwp = jmode2_hb_z1_symbol_words;
  hb_dsymswp = jmode2_hb_z1_dsyms_words;
  ms = #init_msf();
  cp = #protect_ptr(cp, ms);
  lowp = #protect_ptr(lowp, ms);
  hbzp = #protect_ptr(hbzp, ms);
  hp = #protect_ptr(hp, ms);
  badp = #protect_ptr(badp, ms);
  sigp = #protect_ptr(sigp, ms);
  cp, lowp, hbzp, hp, badp = _unpack_sig_full(cp, lowp, hbzp, hp, badp, sigp,
                                              h_symbolwp, h_dsymswp,
                                              hb_symbolwp, hb_dsymswp,
                                              4, 1024, 13, 6, 512, 13, 239,
                                              132, 7, 416);
  return cp, lowp, hbzp, hp, badp;
}

