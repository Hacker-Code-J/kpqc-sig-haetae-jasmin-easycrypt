fn _sample_gauss83(reg u64 rand_lo, reg u32 rand_hi) -> reg u64
{
  reg ptr u32[76] hip;
  reg ptr u64[166] lop;
  reg u64 i r lo hi rndhi;
  reg u32 c;
  reg bool borrow;

  hip = jcdt83_hi;
  lop = jcdt83_lo;
  rndhi = (64u)rand_hi;
  i = 0;
  r = 0;
  while (i < 76)
  {
    c = hip[i];
    hi = (64u)c;
    lo = lop[i];
    borrow, lo -= rand_lo;
    _, hi = hi - rndhi - borrow;
    hi >>= 63;
    r += hi;
    i += 1;
  }
  while (i < 166)
  {
    hi = 0x7ffff;
    lo = lop[i];
    borrow, lo -= rand_lo;
    _, hi = hi - rndhi - borrow;
    hi >>= 63;
    r += hi;
    i += 1;
  }

  return r;
}

/* Signed a times unsigned b, rounded toward positive infinity after /2^48. */
fn __smulh48(reg u64 a b) -> reg u64
{
  reg u64 hi lo r tmp rem rax rdx;

  rax = a;
  rdx, rax = rax * b;
  hi = rdx;
  lo = rax;
  tmp = a;
  tmp >>s= 63;
  tmp &= b;
  hi -= tmp;

  r = hi;
  r <<= 16;
  tmp = lo;
  tmp >>= 48;
  r |= tmp;
  rem = lo;
  rem &= 0xffffffffffff;
  tmp = 0;
  tmp -= rem;
  rem |= tmp;
  rem >>= 63;
  r += rem;

  return r;
}

/* GALACTICS degree-10 ceiling approximation, with lifted constant term. */
fn _approx_exp(reg u64 x) -> reg u64
{
  reg u64 result;

  result = 55868746;
  result = __smulh48(result, x);
  result -= 743564434;
  result = __smulh48(result, x);
  result += 6953427278;
  result = __smulh48(result, x);
  result -= 55833338892;
  result = __smulh48(result, x);
  result += 390932311155;
  result = __smulh48(result, x);
  result -= 2345623661771;
  result = __smulh48(result, x);
  result += 11728123872951;
  result = __smulh48(result, x);
  result -= 46912496106200;
  result = __smulh48(result, x);
  result += 140737488354861;
  result = __smulh48(result, x);
  result -= 281474976710650;
  result = __smulh48(result, x);
  result += 281474976710657;

  return result;
}

fn __sample_gauss_sigma76_regs(reg const ptr u8[26] randp)
                                -> reg u64, reg u64, reg u64, reg u64
{
  stack u64[2] y;
  stack u64[2] sqrbuf;
  reg ptr u64[2] yp;
  reg ptr u64[2] sqrp;
  reg u64 rand_gauss83_lo rand_rej x y0 y1 rounded exp_in exp;
  reg u64 t u accepted sqr0 sqr1;
  reg u32 rand_gauss83_hi;
  reg u8 byte;
  #[msf] reg u64 ms;

  byte = randp[0];
  rand_gauss83_lo = (64u)byte;
  byte = randp[1];
  t = (64u)byte;
  t <<= 8;
  rand_gauss83_lo |= t;
  byte = randp[2];
  t = (64u)byte;
  t <<= 16;
  rand_gauss83_lo |= t;
  byte = randp[3];
  t = (64u)byte;
  t <<= 24;
  rand_gauss83_lo |= t;
  byte = randp[4];
  t = (64u)byte;
  t <<= 32;
  rand_gauss83_lo |= t;
  byte = randp[5];
  t = (64u)byte;
  t <<= 40;
  rand_gauss83_lo |= t;
  byte = randp[6];
  t = (64u)byte;
  t <<= 48;
  rand_gauss83_lo |= t;
  byte = randp[7];
  t = (64u)byte;
  t <<= 56;
  rand_gauss83_lo |= t;

  byte = randp[8];
  u = (64u)byte;
  byte = randp[9];
  t = (64u)byte;
  t <<= 8;
  u |= t;
  byte = randp[10];
  t = (64u)byte;
  t <<= 16;
  u |= t;

  u &= 0x7ffff;
  rand_gauss83_hi = (32u)u;
  x = _sample_gauss83(rand_gauss83_lo, rand_gauss83_hi);

  byte = randp[11];
  rand_rej = (64u)byte;
  byte = randp[12];
  t = (64u)byte;
  t <<= 8;
  rand_rej |= t;
  byte = randp[13];
  t = (64u)byte;
  t <<= 16;
  rand_rej |= t;
  byte = randp[14];
  t = (64u)byte;
  t <<= 24;
  rand_rej |= t;
  byte = randp[15];
  t = (64u)byte;
  t <<= 32;
  rand_rej |= t;
  byte = randp[16];
  t = (64u)byte;
  t <<= 40;
  rand_rej |= t;

  byte = randp[17];
  y0 = (64u)byte;
  byte = randp[18];
  t = (64u)byte;
  t <<= 8;
  y0 |= t;
  byte = randp[19];
  t = (64u)byte;
  t <<= 16;
  y0 |= t;
  byte = randp[20];
  t = (64u)byte;
  t <<= 24;
  y0 |= t;
  byte = randp[21];
  t = (64u)byte;
  t <<= 32;
  y0 |= t;
  byte = randp[22];
  t = (64u)byte;
  t <<= 40;
  y0 |= t;

  byte = randp[23];
  y1 = (64u)byte;
  byte = randp[24];
  t = (64u)byte;
  t <<= 8;
  y1 |= t;
  byte = randp[25];
  t = (64u)byte;
  t <<= 16;
  y1 |= t;

  t = x;
  t <<= 24;
  y1 |= t;

  /* Split rounding preserves the upper bit for CDT samples x >= 128. */
  rounded = y0;
  rounded >>= 15;
  rounded += 1;
  rounded >>= 1;
  t = y1;
  t <<= 32;
  rounded += t;

  y[0] = y0;
  y[1] = y1;
  yp = y;
  sqrp = sqrbuf;
  sqrp = _fixpoint_square(sqrp, yp);
  sqr0 = sqrp[0];
  sqr1 = sqrp[1];

  exp_in = sqr1;
  t = x;
  t *= x;
  t <<= 20;
  exp_in -= t;
  exp_in <<= 20;
  t = sqr0;
  t >>= 28;
  exp_in |= t;
  exp_in += 1;
  exp_in >>= 1;
  () = #declassify(exp_in);
  ms = #init_msf();
  exp_in = #protect(exp_in, ms);

  exp = _approx_exp(exp_in);
  accepted = rand_rej;
  t = rand_rej;
  t &= 1;
  accepted ^= t;
  accepted -= exp;
  accepted >>s= 63;

  t = 0;
  t -= rounded;
  u = rounded;
  u |= t;
  u >>= 63;
  u |= rand_rej;
  accepted &= u;
  accepted &= 1;

  return rounded, sqr0, sqr1, accepted;
}

fn _sample_gauss_sigma76(reg mut ptr u64[1] rp,
                         reg mut ptr u64[2] sqrp,
                         reg mut ptr u32[1] acceptedp,
                         reg const ptr u8[26] randp)
                         -> reg ptr u64[1],
                            reg ptr u64[2],
                            reg ptr u32[1]
{
  reg u64 sample sqr0 sqr1 accepted;

  sample, sqr0, sqr1, accepted = __sample_gauss_sigma76_regs(randp);
  rp[0] = sample;
  sqrp[0] = sqr0;
  sqrp[1] = sqr1;
  acceptedp[0] = (32u)accepted;

  return rp, sqrp, acceptedp;
}

fn _sample_gauss(reg mut ptr u64[512] rp,
                 reg mut ptr u64[2] sqsump,
                 reg mut ptr u64[1] coefcntp,
                 reg const ptr u8[8192] bufp,
                 reg u64 counts,
                 reg u64 dont_write_last) -> reg ptr u64[512],
                                            reg ptr u64[2],
                                            reg ptr u64[1]
{
  stack ptr u64[512] srp;
  stack ptr u64[2] ssqsump;
  stack ptr u64[1] scoefcntp;
  stack ptr u8[8192] sbufp;
  stack u64 slen sbytecnt spos scoefcnt sdont;
  stack u8[26] randbuf;
  reg ptr u64[512] rp_tmp;
  reg ptr u64[2] sqsum_tmp;
  reg ptr u64[1] coefcntp_tmp;
  reg const ptr u8[8192] bufp_tmp;
  reg ptr u8[26] randp;
  inline int k;
  reg u64 len bytecnt pos coefcnt last sample accepted accepted64 dont;
  reg u64 s0 s1 sqr0 sqr1 mask carry;
  reg u8 byte;
  #[msf] reg u64 ms;

  srp = rp;
  ssqsump = sqsump;
  scoefcntp = coefcntp;
  sbufp = bufp;
  sdont = dont_write_last;

  len = counts;
  len &= 0xffffffff;
  bytecnt = counts;
  bytecnt >>= 32;
  slen = len;
  sbytecnt = bytecnt;
  spos = 0;
  scoefcnt = 0;

  randp = randbuf;

  while { coefcnt = scoefcnt; len = slen; } (coefcnt < len)
  {
    bytecnt = sbytecnt;
    if (bytecnt < 26)
    {
      slen = coefcnt;
    }
    else
    {
      pos = spos;
      bufp_tmp = sbufp;
      for k = 0 to 26
      {
        byte = bufp_tmp[pos + k];
        randp[k] = byte;
      }

      sample, sqr0, sqr1, accepted = __sample_gauss_sigma76_regs(randp);
      () = #declassify(coefcnt);
      () = #declassify(len);
      () = #declassify(pos);
      () = #declassify(bytecnt);
      () = #declassify(accepted);
      ms = #init_msf();
      coefcnt = #protect(coefcnt, ms);
      len = #protect(len, ms);
      pos = #protect(pos, ms);
      bytecnt = #protect(bytecnt, ms);
      accepted = #protect(accepted, ms);

      last = len;
      last -= 1;
      dont = sdont;
      () = #declassify(dont);
      dont = #protect(dont, ms);
      rp_tmp = srp;
      rp_tmp = #protect_ptr(rp_tmp, ms);
      if (dont != 0)
      {
        if (coefcnt == last)
        {
          accepted64 = accepted;
        }
        else
        {
          rp_tmp[coefcnt] = sample;
          srp = rp_tmp;
          accepted64 = accepted;
        }
      }
      else
      {
        rp_tmp[coefcnt] = sample;
        srp = rp_tmp;
        accepted64 = accepted;
      }

      coefcnt += accepted64;
      pos += 26;
      bytecnt -= 26;

      mask = 0;
      mask -= accepted64;
      sqr0 &= mask;
      sqr1 &= mask;
      sqsum_tmp = ssqsump;
      ms = #init_msf();
      sqsum_tmp = #protect_ptr(sqsum_tmp, ms);
      s0 = sqsum_tmp[0];
      s1 = sqsum_tmp[1];
      s0 += sqr0;
      s1 += sqr1;
      sqsum_tmp[0] = s0;
      sqsum_tmp[1] = s1;
      ssqsump = sqsum_tmp;
      scoefcnt = coefcnt;
      spos = pos;
      sbytecnt = bytecnt;
    }
  }

  sqsum_tmp = ssqsump;
  s0 = sqsum_tmp[0];
  s1 = sqsum_tmp[1];
  carry = s0;
  carry >>= 48;
  s1 += carry;
  mask = 0xffffffffffff;
  s0 &= mask;
  sqsum_tmp[0] = s0;
  sqsum_tmp[1] = s1;
  ssqsump = sqsum_tmp;

  coefcnt = scoefcnt;
  coefcntp_tmp = scoefcntp;
  coefcntp_tmp[0] = coefcnt;
  scoefcntp = coefcntp_tmp;

  rp = srp;
  sqsump = ssqsump;
  coefcntp = scoefcntp;
  return rp, sqsump, coefcntp;
}

fn _sample_gauss_N_copy_signs(reg mut ptr u8[1024] signsp,
                              reg const ptr u8[8192] bufp,
                              reg u64 signbytes) -> reg ptr u8[1024]
{
  reg u64 i;
  reg u8 b;

  i = 0;
  while (i < signbytes)
  {
    b = bufp[i];
    signsp[i] = b;
    i += 1;
  }

  return signsp;
}

fn _sample_gauss_N_carry(reg mut ptr u8[8192] bufp,
                         reg u64 bytecnt,
                         reg u64 signbytes,
                         reg u64 firstflag,
                         reg u64 off) -> reg ptr u8[8192]
{
  reg u64 i src idx;
  reg u8 b;

  src = bytecnt;
  if (firstflag != 0)
  {
    src += signbytes;
  }
  src -= off;

  i = 0;
  while (i < off)
  {
    idx = src;
    idx += i;
    b = bufp[idx];
    bufp[i] = b;
    i += 1;
  }

  return bufp;
}

fn _rej_uniform(reg mut ptr u32[512] ap, reg mut ptr u32[1] ctrp,
                reg u64 len, reg const ptr u8[1024] bp,
                reg u64 buflen) -> reg ptr u32[512], reg ptr u32[1]
{
  reg u64 ctr pos rem;
  reg u8 byte;
  reg u32 t u;
  #[msf] reg u64 ms;

  ctr = 0;
  pos = 0;
  while (ctr < len)
  {
    rem = buflen;
    rem -= pos;
    if (rem < 2)
    {
      len = ctr;
    }
    else
    {
      byte = bp[pos];
      t = (32u)byte;
      pos += 1;
      byte = bp[pos];
      u = (32u)byte;
      pos += 1;
      u <<= 8;
      t |= u;
      () = #declassify(t);
      ms = #init_msf();
      t = #protect_32(t, ms);

      if (t < HAETAE_Q)
      {
        ap[ctr] = t;
        ctr += 1;
      }
    }
  }

  ctrp[0] = (32u)ctr;
  return ap, ctrp;
}

inline fn __mod3(reg u32 t) -> reg u32
{
  reg u32 r u;

  r = t;
  r >>= 4;
  u = t;
  u &= 15;
  r += u;

  u = r;
  u >>= 2;
  r &= 3;
  r += u;

  u = r;
  u >>= 2;
  r &= 3;
  r += u;

  u = r;
  u >>= 2;
  r &= 3;
  r += u;

  u = r;
  u >>= 1;
  u *= 3;
  r -= u;
  return r;
}

inline fn __mod3_leq26(reg u32 t) -> reg u32
{
  reg u32 r u;

  r = t;
  r >>= 4;
  u = t;
  u &= 15;
  r += u;

  u = r;
  u >>= 2;
  r &= 3;
  r += u;

  u = r;
  u >>= 2;
  r &= 3;
  r += u;

  u = r;
  u >>= 1;
  u *= 3;
  r -= u;
  return r;
}

inline fn __mod3_leq8(reg u32 t) -> reg u32
{
  reg u32 r u;

  r = t;
  r >>= 2;
  u = t;
  u &= 3;
  r += u;

  u = r;
  u >>= 2;
  r &= 3;
  r += u;

  u = r;
  u >>= 1;
  u *= 3;
  r -= u;
  return r;
}

fn _rej_eta(reg mut ptr u32[512] ap, reg mut ptr u32[1] ctrp,
            reg u64 len, reg const ptr u8[1024] bp,
            reg u64 buflen) -> reg ptr u32[512], reg ptr u32[1]
{
  reg u64 ctr pos;
  reg u8 byte;
  reg u32 t r;
  #[msf] reg u64 ms;

  ctr = 0;
  pos = 0;
  while (ctr < len)
  {
    if (pos < buflen)
    {
      byte = bp[pos];
      t = (32u)byte;
      pos += 1;
      () = #declassify(t);
      ms = #init_msf();
      t = #protect_32(t, ms);
      if (t < 243)
      {
        r = __mod3(t);
        ap[ctr] = r;
        ctr += 1;

        if (ctr < len)
        {
          t *= 171;
          t >>= 9;
          r = __mod3(t);
          ap[ctr] = r;
          ctr += 1;
        }

        if (ctr < len)
        {
          t *= 171;
          t >>= 9;
          r = __mod3_leq26(t);
          ap[ctr] = r;
          ctr += 1;
        }

        if (ctr < len)
        {
          t *= 171;
          t >>= 9;
          r = __mod3_leq8(t);
          ap[ctr] = r;
          ctr += 1;
        }

        if (ctr < len)
        {
          t *= 171;
          t >>= 9;
          r = t;
          r >>= 1;
          r *= 3;
          t -= r;
          ap[ctr] = t;
          ctr += 1;
        }
      }
    }
    else
    {
      len = ctr;
    }
  }

  ctrp[0] = (32u)ctr;
  return ap, ctrp;
}
