package "ocamlbuild" {
  opam-version: "2.0"
  version: "0.16.1"
  synopsis:
    "OCamlbuild is a build system with builtin rules to easily build most OCaml projects"
  maintainer: "Gabriel Scherer <gabriel.scherer@gmail.com>"
  authors: ["Nicolas Pouillard" "Berke Durak"]
