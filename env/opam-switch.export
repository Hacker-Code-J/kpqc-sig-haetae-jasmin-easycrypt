    "conf-pkg-config" {build}
    ("host-arch-x86_64"
       {os = "win32" &
        (os-distribution = "cygwin" | os-distribution = "msys2")} &
     "conf-mingw-w64-pcre2-x86_64"
       {os = "win32" &
        (os-distribution = "cygwin" | os-distribution = "msys2")} |
     "host-arch-x86_32"
       {os = "win32" &
        (os-distribution = "cygwin" | os-distribution = "msys2")} &
