    "alcotest" {with-test & >= "1.5.0"}
    "jsonm" {>= "1.0.0"}
    "uutf"
    "js_of_ocaml-compiler" {with-test}
    "conf-npm" {with-test}
    "sexplib0"
    "hex"
  ]
  build: [
    ["dune" "subst"] {dev}
    ["dune" "build" "-p" name "-j" jobs]
  ]
  dev-repo: "git+https://github.com/mirage/ezjsonm.git"
  url {
