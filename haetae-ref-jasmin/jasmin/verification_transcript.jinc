fn __verify_shake256_absorb_raw(reg mut ptr u64[25] sp,
                                reg mut ptr u64[2] statep,
                                reg u64 inp,
                                reg u64 inlen) -> reg ptr u64[25],
                                                  reg ptr u64[2]
{
  reg u64 pos lane t;
  reg u8 b shift;

  pos = statep[0];
  while (inlen != 0)
  {
    lane = pos;
    lane >>= 3;
    b = [:u8 inp];
    t = (64u)b;
    shift = (8u)pos;
    shift &= 7;
    shift <<= 3;
    t <<= (shift & 63);
    sp[lane] ^= t;
    inp += 1;
    pos += 1;
    inlen -= 1;

    if (pos == 136)
    {
      () = #spill(statep, inp, inlen, pos);
      sp = _keccakf1600(sp);
      () = #unspill(statep, inp, inlen, pos);
      pos = 0;
    }
  }

  statep[0] = pos;
  return sp, statep;
}

fn __verify_shake256_absorb_byte(reg mut ptr u64[25] sp,
                                 reg mut ptr u64[2] statep,
                                 reg u8 b) -> reg ptr u64[25],
                                            reg ptr u64[2]
{
  reg u64 pos lane t;
  reg u8 shift;

  pos = statep[0];
  lane = pos;
  lane >>= 3;
  t = (64u)b;
  shift = (8u)pos;
  shift &= 7;
  shift <<= 3;
  t <<= (shift & 63);
  sp[lane] ^= t;
  pos += 1;

  if (pos == 136)
  {
    () = #spill(statep, pos);
    sp = _keccakf1600(sp);
    () = #unspill(statep, pos);
    pos = 0;
  }

  statep[0] = pos;
  return sp, statep;
}

fn __verify_shake256_absorb_buf(reg mut ptr u64[25] sp,
                                reg mut ptr u64[2] statep,
                                reg const ptr u8[1152] inp,
                                reg u64 inlen) -> reg ptr u64[25],
                                                  reg ptr u64[2]
{
  reg u64 pos lane i t;
  reg u8 b shift;

  pos = statep[0];
  i = 0;
  while (i < inlen)
  {
    lane = pos;
    lane >>= 3;
    b = inp[i];
    t = (64u)b;
    shift = (8u)pos;
    shift &= 7;
    shift <<= 3;
    t <<= (shift & 63);
    sp[lane] ^= t;
    i += 1;
    pos += 1;

    if (pos == 136)
    {
      () = #spill(statep, inp, inlen, i, pos);
      sp = _keccakf1600(sp);
      () = #unspill(statep, inp, inlen, i, pos);
      pos = 0;
    }
  }

  statep[0] = pos;
  return sp, statep;
}

fn __verify_shake256_absorb_mu32(reg mut ptr u64[25] sp,
                                 reg mut ptr u64[2] statep,
                                 reg const ptr u8[32] inp)
                                 -> reg ptr u64[25],
                                    reg ptr u64[2]
{
  reg u64 pos lane i t;
  reg u8 b shift;

  pos = statep[0];
  i = 0;
  while (i < 32)
  {
    lane = pos;
    lane >>= 3;
    b = inp[i];
    t = (64u)b;
    shift = (8u)pos;
    shift &= 7;
    shift <<= 3;
    t <<= (shift & 63);
    sp[lane] ^= t;
    i += 1;
    pos += 1;
  }

  statep[0] = pos;
  return sp, statep;
}

fn __verify_zero_highbuf(reg mut ptr u8[1152] bp,
                         reg u64 len) -> reg ptr u8[1152]
{
  reg u64 i;

  i = 0;
  while (i < len)
  {
    bp[i] = 0;
    i += 1;
  }

  return bp;
}

fn __verify_hash_mu(reg mut ptr u8[32] mup,
                    reg u64 vkp,
                    reg u64 prep,
                    reg u64 prelen,
                    reg u64 mp,
                    reg u64 mlen,
                    reg u64 vklen) -> reg ptr u8[32]
{
  stack u64[25] state;
  stack u64[2] st;
  reg ptr u64[25] sp;
  reg ptr u64[2] stp;
  reg u64 inlen ctxflag ctxlen;
  reg u8 b;

  sp = state;
  stp = st;
  stp[0] = 0;
  stp[1] = 136;

  sp = _keccak_init_state(sp);
  inlen = vklen;
  () = #spill(prep, prelen, mp, mlen);
  sp, stp = __verify_shake256_absorb_raw(sp, stp, vkp, inlen);
  () = #unspill(prep, prelen, mp, mlen);
  ctxflag = prelen;
  ctxflag >>= 63;
  if (ctxflag == 0)
  {
    () = #spill(mp, mlen);
    sp, stp = __verify_shake256_absorb_raw(sp, stp, prep, prelen);
    () = #unspill(mp, mlen);
  }
  else
  {
    ctxlen = prelen;
    ctxlen <<= 1;
    ctxlen >>= 1;
    b = (8u)ctxlen;
    () = #spill(mp, mlen, prep, ctxlen);
    sp, stp = __verify_shake256_absorb_byte(sp, stp, b);
    () = #unspill(mp, mlen, prep, ctxlen);
    () = #spill(mp, mlen);
    sp, stp = __verify_shake256_absorb_raw(sp, stp, prep, ctxlen);
    () = #unspill(mp, mlen);
  }
  sp, stp = __verify_shake256_absorb_raw(sp, stp, mp, mlen);
  sp = __poly_challenge_shake256_finalize(sp, stp);
  mup, sp = __poly_challenge_squeeze256_32(mup, sp);

  return mup;
}

fn __verify_challenge_absorb(reg mut ptr u64[25] sp,
                             reg const ptr u8[1152] highp,
                             reg u64 highlen,
                             reg const ptr u8[32] lsbp,
                             reg const ptr u8[32] mup) -> reg ptr u64[25]
{
  stack u64[2] st;
  reg ptr u64[2] stp;

  stp = st;
  stp[0] = 0;
  stp[1] = 136;

  sp = _keccak_init_state(sp);
  () = #spill(lsbp, mup);
  sp, stp = __verify_shake256_absorb_buf(sp, stp, highp, highlen);
  () = #unspill(lsbp, mup);
  () = #spill(mup);
  sp, stp = __verify_shake256_absorb_mu32(sp, stp, lsbp);
  () = #unspill(mup);
  sp, stp = __verify_shake256_absorb_mu32(sp, stp, mup);
  sp = __poly_challenge_shake256_finalize(sp, stp);

  return sp;
}

fn __verify_challenge_m23(reg mut ptr u32[HAETAE_N] cp,
                          reg const ptr u8[1152] highp,
                          reg u64 highlen,
                          reg const ptr u8[32] lsbp,
                          reg const ptr u8[32] mup,
                          reg u64 tau) -> reg ptr u32[HAETAE_N]
{
  stack u64[25] state;
  stack u8[136] buf;
  reg ptr u64[25] sp;
  reg ptr u8[136] bp;
  reg u64 i pos bidx limit;
  reg u32 b old;

  sp = state;
  bp = buf;
  () = #spill(cp, tau);
  sp = __verify_challenge_absorb(sp, highp, highlen, lsbp, mup);
  () = #unspill(cp, tau);
  () = #spill(cp, tau);
  bp, sp = __poly_challenge_squeeze256_136(bp, sp);
  () = #unspill(cp, tau);

  cp = _poly_challenge_m23_init(cp);
  i = HAETAE_N;
  i -= tau;
  pos = 0;
  while (i < HAETAE_N)
  {
    if (pos >= 136)
    {
      () = #spill(cp, i);
      bp, sp = __poly_challenge_squeeze256_136(bp, sp);
      () = #unspill(cp, i);
      pos = 0;
    }

    b = (32u)bp[pos];
    pos += 1;
    bidx = (64u)b;
    limit = i;
    limit += 1;

    if (bidx < limit)
    {
      old = cp[bidx];
      cp[i] = old;
      cp[bidx] = 1;
      i += 1;
    }
  }

  return cp;
}

fn __verify_challenge_m5(reg mut ptr u32[HAETAE_N] cp,
                         reg const ptr u8[1152] highp,
                         reg u64 highlen,
                         reg const ptr u8[32] lsbp,
                         reg const ptr u8[32] mup)
                         -> reg ptr u32[HAETAE_N]
{
  stack u64[25] state;
  stack u8[32] buf;
  reg ptr u64[25] sp;
  reg ptr u8[32] bp;

  sp = state;
  bp = buf;

  () = #spill(cp);
  sp = __verify_challenge_absorb(sp, highp, highlen, lsbp, mup);
  () = #unspill(cp);
  () = #spill(cp);
  bp, sp = __poly_challenge_squeeze256_32(bp, sp);
  () = #unspill(cp);

  cp = _poly_challenge_m5_frombytes(cp, bp);
  return cp;
}

inline fn _sign_verify_tail_m23(reg const ptr u32[2048] wp,
                                reg const ptr u32[HAETAE_N] wprimep,
                                reg const ptr u32[HAETAE_N] cp,
                                reg const ptr u64[5] descp,
                                inline int k_i,
                                inline int highbits_len_i,
                                inline int vklen_i,
                                inline int tau_i) -> reg u64
{
  stack u8[1152] highbuf;
  stack u8[32] lsb;
  stack u8[32] mu;
  stack u32[HAETAE_N] cprime;
  reg ptr u8[1152] highp;
  reg ptr u8[32] mup lsbp;
  reg ptr u32[HAETAE_N] cprimep;
  reg u64 count highlen reject vklen tau;
  reg u64 vkp prep prelen mp mlen;

  highp = highbuf;
  lsbp = lsb;
  mup = mu;
  cprimep = cprime;
  vkp = descp[0];
  prep = descp[1];
  prelen = descp[2];
  mp = descp[3];
  mlen = descp[4];
  highlen = highbits_len_i;

  () = #spill(wp, wprimep, cp, vkp, prep, prelen, mp, mlen);
  highp = __verify_zero_highbuf(highp, highlen);
  () = #unspill(wp, wprimep, cp, vkp, prep, prelen, mp, mlen);

  count = k_i;
  () = #spill(wprimep, cp, vkp, prep, prelen, mp, mlen);
  highp = _pack_vec_highbits_m23(highp, wp, count);
  () = #unspill(wprimep, cp, vkp, prep, prelen, mp, mlen);

  () = #spill(cp, vkp, prep, prelen, mp, mlen, highp);
  lsbp = _pack_poly_lsb(lsbp, wprimep);
  () = #unspill(cp, vkp, prep, prelen, mp, mlen, highp);

  vklen = vklen_i;
  () = #spill(cp, highp, lsbp, cprimep, highlen);
  mup = __verify_hash_mu(mup, vkp, prep, prelen, mp, mlen, vklen);
  () = #unspill(cp, highp, lsbp, cprimep, highlen);

  tau = tau_i;
  () = #spill(cp);
  cprimep = __verify_challenge_m23(cprimep, highp, highlen, lsbp, mup, tau);
  () = #unspill(cp);
  reject = _poly_mismatch(cp, cprimep);

  return reject;
}

inline fn _sign_verify_tail_m5(reg const ptr u32[2048] wp,
                               reg const ptr u32[HAETAE_N] wprimep,
                               reg const ptr u32[HAETAE_N] cp,
                               reg const ptr u64[5] descp) -> reg u64
{
  stack u8[1152] highbuf;
  stack u8[32] lsb;
  stack u8[32] mu;
  stack u32[HAETAE_N] cprime;
  reg ptr u8[1152] highp;
  reg ptr u8[32] mup lsbp;
  reg ptr u32[HAETAE_N] cprimep;
  reg u64 count highlen reject vklen;
  reg u64 vkp prep prelen mp mlen;

  highp = highbuf;
  lsbp = lsb;
  mup = mu;
  cprimep = cprime;
  vkp = descp[0];
  prep = descp[1];
  prelen = descp[2];
  mp = descp[3];
  mlen = descp[4];
  highlen = 1152;

  () = #spill(wp, wprimep, cp, vkp, prep, prelen, mp, mlen);
  highp = __verify_zero_highbuf(highp, highlen);
  () = #unspill(wp, wprimep, cp, vkp, prep, prelen, mp, mlen);

  count = 4;
  () = #spill(wprimep, cp, vkp, prep, prelen, mp, mlen);
  highp = _pack_vec_highbits_m5(highp, wp, count);
  () = #unspill(wprimep, cp, vkp, prep, prelen, mp, mlen);

  () = #spill(cp, vkp, prep, prelen, mp, mlen, highp);
  lsbp = _pack_poly_lsb(lsbp, wprimep);
  () = #unspill(cp, vkp, prep, prelen, mp, mlen, highp);

  vklen = 2080;
  () = #spill(cp, highp, lsbp, cprimep, highlen);
  mup = __verify_hash_mu(mup, vkp, prep, prelen, mp, mlen, vklen);
  () = #unspill(cp, highp, lsbp, cprimep, highlen);

  () = #spill(cp);
  cprimep = __verify_challenge_m5(cprimep, highp, highlen, lsbp, mup);
  () = #unspill(cp);
  reject = _poly_mismatch(cp, cprimep);

  return reject;
}
