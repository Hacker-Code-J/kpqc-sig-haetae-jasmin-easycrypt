                                               reg ptr u64[1]
{
  #[msf] reg u64 ms;

  ms = #init_msf();
  rp = #protect_ptr(rp, ms);
  sqsump = #protect_ptr(sqsump, ms);
  coefcntp = #protect_ptr(coefcntp, ms);
  bufp = #protect_ptr(bufp, ms);
  counts = #protect(counts, ms);
  dont_write_last = #protect(dont_write_last, ms);
  rp, sqsump, coefcntp = _sample_gauss(rp, sqsump, coefcntp, bufp, counts,
                                       dont_write_last);
  return rp, sqsump, coefcntp;
}

