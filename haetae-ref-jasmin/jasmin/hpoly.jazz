#[ct = "sp * public * public * domain -> {domain, sp}"]
export
fn keccak_finalize_jazz(reg mut ptr u64[25] sp,
                        reg u64 pos,
                        reg u64 rate,
                        reg u8 domain) -> reg ptr u64[25]
{
  #[msf] reg u64 ms;

  ms = #init_msf();
  sp = #protect_ptr(sp, ms);
  pos = #protect(pos, ms);
  rate = #protect(rate, ms);
  domain = #protect_8(domain, ms);
  sp = _keccak_finalize(sp, pos, rate, domain);
  return sp;
}

#[ct = "sp * public * public * public * domain -> secret"]
export
fn keccak_absorb_once_jazz(reg mut ptr u64[25] sp,
                           reg u64 rate,
                           reg ui64 inp,
                           reg u64 inlen,
                           reg u8 domain) -> reg ptr u64[25]
{
  #[msf] reg u64 ms;

  ms = #init_msf();
  sp = #protect_ptr(sp, ms);
  rate = #protect(rate, ms);
  inlen = #protect(inlen, ms);
  domain = #protect_8(domain, ms);
  sp = _keccak_absorb_once(sp, rate, inp, inlen, domain);
  return sp;
}

#[ct = "sp * public * public * public -> secret * public"]
export
fn keccak_absorb_jazz(reg mut ptr u64[25] sp,
                      reg mut ptr u64[2] statep,
                      reg ui64 inp,
                      reg u64 inlen) -> reg ptr u64[25],
                                         reg ptr u64[2]
{
  #[msf] reg u64 ms;

  ms = #init_msf();
  sp = #protect_ptr(sp, ms);
  statep = #protect_ptr(statep, ms);
  inlen = #protect(inlen, ms);
  sp, statep = _keccak_absorb(sp, statep, inp, inlen);
  return sp, statep;
}

