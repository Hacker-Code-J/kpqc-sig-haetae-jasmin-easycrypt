#[ct = "public -> secret"]
export
fn randombytes_seed32_jazz(reg mut ptr u8[32] outp) -> reg ptr u8[32]
{
  #[msf] reg u64 ms;

  ms = #init_msf();
  outp = #protect_ptr(outp, ms);
  outp = #randombytes(outp);
  ms = #init_msf();
  outp = #protect_ptr(outp, ms);
  return outp;
}

