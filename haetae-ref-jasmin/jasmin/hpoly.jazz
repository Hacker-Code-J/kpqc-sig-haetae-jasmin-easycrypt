export
fn fixpoint_newton_invsqrt_jazz(reg mut ptr u64[2] rp,
                                reg const ptr u64[2] xhalfp,
                                reg const ptr u64[2] start_cubep,
                                reg const ptr u64[2] start_threep)
                                -> reg ptr u64[2]
{
  rp = _fixpoint_newton_invsqrt(rp, xhalfp, start_cubep, start_threep);
  return rp;
}

export
fn polyfixveclk_scale_samples_jazz(reg mut ptr u32[2048] y1p,
                                   reg mut ptr u32[2048] y2p,
                                   reg const ptr u64[4096] samplesp,
                                   reg const ptr u8[512] signsp,
                                   reg const ptr u64[2] scalep,
                                   reg u64 counts) -> reg ptr u32[2048],
                                                     reg ptr u32[2048]
{
  y1p, y2p = _polyfixveclk_scale_samples(y1p, y2p, samplesp, signsp, scalep,
                                         counts);
  return y1p, y2p;
}

export
fn polyfixveclk_scale_and_check_jazz(reg mut ptr u32[2048] y1p,
                                     reg mut ptr u32[2048] y2p,
                                     reg mut ptr u64[4] statep,
                                     reg const ptr u64[4096] samplesp,
                                     reg const ptr u8[512] signsp,
                                     reg const ptr u64[2] scalep)
                                     -> reg ptr u32[2048],
                                        reg ptr u32[2048],
                                        reg ptr u64[4]
{
  y1p, y2p, statep = _polyfixveclk_scale_and_check(y1p, y2p, statep,
                                                   samplesp, signsp, scalep);
  return y1p, y2p, statep;
}

