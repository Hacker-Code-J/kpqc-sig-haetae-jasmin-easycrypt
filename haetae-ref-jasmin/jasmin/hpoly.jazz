                        reg mut ptr u8[32] keyp,
                        reg const ptr u8[2752] skp) -> reg ptr u32[2048],
                                                               reg ptr u32[2048],
                                                               reg ptr u8[32]
{
  reg u64 vkbytes mcount kcount;
  vkbytes = 2080;
  mcount = 6;
  kcount = 4;
  s0p, s1p, keyp = _unpack_sk_m5(s0p, s1p, keyp, skp, vkbytes, mcount, kcount);
  return s0p, s1p, keyp;
}

