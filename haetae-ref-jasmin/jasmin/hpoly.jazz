                                     reg mut ptr u32[1] ip,
                                     reg mut ptr u32[1] posp,
                                     reg const ptr u8[1024] bp,
                                     reg u64 buflen) -> reg ptr u32[HAETAE_N],
                                                       reg ptr u32[1],
                                                       reg ptr u32[1]
{
  cp, ip, posp = _poly_challenge_m23_frombytes(cp, ip, posp, bp, buflen);
  return cp, ip, posp;
}

export
fn fixpoint_add_jazz(reg mut ptr u64[2] rp,
                     reg const ptr u64[2] ap,
                     reg const ptr u64[2] bp) -> reg ptr u64[2]
{
  rp = _fixpoint_add(rp, ap, bp);
  return rp;
}

export
fn fixpoint_square_jazz(reg mut ptr u64[2] rp,
                        reg const ptr u64[2] ap) -> reg ptr u64[2]
{
  rp = _fixpoint_square(rp, ap);
  return rp;
}

export
fn fixpoint_mul_jazz(reg mut ptr u64[2] rp,
                     reg const ptr u64[2] ap,
                     reg const ptr u64[2] bp) -> reg ptr u64[2]
{
  rp = _fixpoint_mul(rp, ap, bp);
  return rp;
}

export
fn fixpoint_mul_rnd13_jazz(reg u64 x,
                           reg const ptr u64[2] yp,
                           reg u8 sign) -> reg u32
{
  reg u32 r;
  r = _fixpoint_mul_rnd13(x, yp, sign);
  return r;
}

