#[ct = "statep * public * nonce -> secret"]
export
fn shake128_stream_init_jazz(reg mut ptr u64[26] statep,
                             reg ui64 seedp,
                             reg u64 nonce) -> reg ptr u64[26]
{
  reg u64 rate seedlen;
  #[msf] reg u64 ms;

  rate = 168;
  seedlen = 32;
  ms = #init_msf();
  statep = #protect_ptr(statep, ms);
  rate = #protect(rate, ms);
  seedlen = #protect(seedlen, ms);
  nonce = #protect(nonce, ms);
  statep = _shake_stream_init(statep, rate, seedp, seedlen, nonce);
  return statep;
}

