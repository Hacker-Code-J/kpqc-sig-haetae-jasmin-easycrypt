}

export
fn rej_uniform_jazz(reg mut ptr u32[512] ap, reg mut ptr u32[1] ctrp,
                    reg u64 len, reg const ptr u8[1024] bp,
                    reg u64 buflen) -> reg ptr u32[512], reg ptr u32[1]
{
  ap, ctrp = _rej_uniform(ap, ctrp, len, bp, buflen);
  return ap, ctrp;
}

