export
fn sample_gauss_sigma76_jazz(reg mut ptr u64[1] rp,
                             reg mut ptr u64[2] sqrp,
                             reg mut ptr u32[1] acceptedp,
                             reg const ptr u8[17] randp)
                             -> reg ptr u64[1],
                                reg ptr u64[2],
                                reg ptr u32[1]
{
  rp, sqrp, acceptedp = _sample_gauss_sigma76(rp, sqrp, acceptedp, randp);
  return rp, sqrp, acceptedp;
}

export
fn sample_gauss_jazz(reg mut ptr u64[512] rp,
                     reg mut ptr u64[2] sqsump,
                     reg mut ptr u64[1] coefcntp,
                     reg const ptr u8[8192] bufp,
                     reg u64 counts,
                     reg u64 dont_write_last) -> reg ptr u64[512],
                                               reg ptr u64[2],
                                               reg ptr u64[1]
{
  rp, sqsump, coefcntp = _sample_gauss(rp, sqsump, coefcntp, bufp, counts,
                                       dont_write_last);
  return rp, sqsump, coefcntp;
}

export
fn sample_gauss_N_copy_signs_jazz(reg mut ptr u8[1024] signsp,
                                  reg const ptr u8[8192] bufp,
                                  reg u64 signbytes) -> reg ptr u8[1024]
{
