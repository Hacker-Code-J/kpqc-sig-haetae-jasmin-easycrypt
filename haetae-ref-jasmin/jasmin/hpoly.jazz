export
fn pack_sk_mode2_jazz(reg mut ptr u8[2752] skp,
                      reg const ptr u8[2080] vkp,
                      reg const ptr u32[2048] s0p,
                      reg const ptr u32[2048] s1p,
                      reg const ptr u8[32] keyp) -> reg ptr u8[2752]
{
  reg u64 vkbytes mcount kcount;
  vkbytes = 992;
  mcount = 3;
  kcount = 2;
  skp = _pack_sk_m23(skp, vkp, s0p, s1p, keyp, vkbytes, mcount, kcount);
  return skp;
}

