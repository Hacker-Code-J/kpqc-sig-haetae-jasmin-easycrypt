#[ct = "hp * badp * public * public * public * public -> hp * badp"]
export
fn decode_h_mode2_full_jazz(reg mut ptr u32[2048] hp,
                            reg mut ptr u64[1] badp,
                            reg const ptr u8[2048] bufp,
                            reg u64 size_in,
                            reg const ptr u32[512] symbolwp,
                            reg const ptr u32[132] dsymswp) -> reg ptr u32[2048],
                                                               reg ptr u64[1]
{
  reg u64 count mh offset;
  #[msf] reg u64 ms;

  ms = #init_msf();
  hp = #protect_ptr(hp, ms);
  badp = #protect_ptr(badp, ms);
  bufp = #protect_ptr(bufp, ms);
  size_in = #protect(size_in, ms);
  symbolwp = #protect_ptr(symbolwp, ms);
  dsymswp = #protect_ptr(dsymswp, ms);
  count = 512;
  mh = 13;
  offset = 239;
  hp, badp = _decode_h_full(hp, badp, bufp, size_in, symbolwp, dsymswp,
                            count, mh, offset);
  return hp, badp;
}

