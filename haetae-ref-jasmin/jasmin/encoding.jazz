require "encoding.jinc"
require "sparse_encoding.jinc"

#[ct = "outp * sizep * public * public -> outp * sizep"]
export
fn encode_h_mode2_full_jazz(reg mut ptr u8[2048] outp,
                            reg mut ptr u64[1] sizep,
                            reg const ptr u32[2048] hp,
                            reg const ptr u32[132] esymsp) -> reg ptr u8[2048],
                                                             reg ptr u64[1]
{
  reg u64 size count mh offset;
  #[msf] reg u64 ms;

  ms = #init_msf();
  outp = #protect_ptr(outp, ms);
  sizep = #protect_ptr(sizep, ms);
  hp = #protect_ptr(hp, ms);
  esymsp = #protect_ptr(esymsp, ms);
  count = 512;
  mh = 13;
  offset = 239;
  outp, size = _encode_h_full(outp, hp, esymsp, count, mh, offset);
  sizep[0] = size;
  return outp, sizep;
}

