fn __shake256_finalize_fixed(reg mut ptr u64[25] sp,
                             reg const ptr u64[2] statep) -> reg ptr u64[25]
{
  reg u64 pos lane t;
  reg u8 shift;

  pos = statep[0];
  lane = pos;
  lane >>= 3;
  shift = (8u)pos;
  shift &= 7;
  shift <<= 3;

  t = 0x1f;
  t <<= (shift & 63);
  sp[lane] ^= t;

  t = 1;
  t <<= 63;
  sp[16] ^= t;

  return sp;
}

fn __shake256_absorb_fixed(reg mut ptr u64[25] sp,
                           reg mut ptr u64[2] statep,
                           reg ui64 inp,
                           reg u64 inlen) -> reg ptr u64[25],
                                             reg ptr u64[2]
{
  reg u64 pos lane t;
  reg u8 b shift;

  pos = statep[0];
  while (inlen != 0)
  {
    lane = pos;
    lane >>= 3;
    b = [:u8 (64u)inp];
    t = (64u)b;
    shift = (8u)pos;
    shift &= 7;
    shift <<= 3;
    t <<= (shift & 63);
    sp[lane] ^= t;
    inp += 1;
    pos += 1;
    inlen -= 1;

    if (pos == 136)
    {
      () = #spill(statep, inp, inlen, pos);
      sp = _keccakf1600(sp);
      () = #unspill(statep, inp, inlen, pos);
      pos = 0;
    }
  }

  statep[0] = pos;
  return sp, statep;
}

fn __shake256_absorb_fixed_addr(reg mut ptr u64[25] sp,
                                reg mut ptr u64[2] statep,
                                reg u64 inp,
                                reg u64 inlen) -> reg ptr u64[25],
                                                  reg ptr u64[2]
{
  reg u64 pos lane t;
  reg u8 b shift;

  pos = statep[0];
  while (inlen != 0)
  {
    lane = pos;
    lane >>= 3;
    b = [:u8 inp];
    t = (64u)b;
    shift = (8u)pos;
    shift &= 7;
    shift <<= 3;
    t <<= (shift & 63);
    sp[lane] ^= t;
    inp += 1;
    pos += 1;
    inlen -= 1;

    if (pos == 136)
    {
      () = #spill(statep, inp, inlen, pos);
      sp = _keccakf1600(sp);
      () = #unspill(statep, inp, inlen, pos);
      pos = 0;
    }
  }

  statep[0] = pos;
  return sp, statep;
}

fn _shake256_absorb_twice(reg mut ptr u64[26] statep,
                          reg ui64 in1p,
                          reg u64 in1len,
                          reg ui64 in2p,
                          reg u64 in2len) -> reg ptr u64[26]
{
  stack u64[2] st;
  reg ptr u64[2] stp;
  reg ptr u64[25] sp;
  reg ui64 inp;
  reg u64 inlen;

  sp = statep[0:25];
  stp = st;
  stp[0] = 0;
  stp[1] = 136;

  sp = _keccak_init_state(sp);
  inp = in1p;
  inlen = in1len;
  () = #spill(in2p, in2len);
  sp, stp = __shake256_absorb_fixed(sp, stp, inp, inlen);
  () = #unspill(in2p, in2len);
  inp = in2p;
  inlen = in2len;
  sp, stp = __shake256_absorb_fixed(sp, stp, inp, inlen);
  sp = __shake256_finalize_fixed(sp, stp);

  statep[0:25] = sp;
  statep.[:u32 200] = 136;
  statep.[:u32 204] = 0;

  return statep;
}

fn _shake256_absorb_twice_start(reg mut ptr u64[26] statep,
                                reg ui64 in1p,
                                reg u64 in1len,
                                reg ui64 in2p,
                                reg u64 in2len) -> reg ptr u64[26]
{
  stack u64[2] st;
  reg ptr u64[2] stp;
  reg ptr u64[25] sp;
  reg ui64 inp;
  reg u64 inlen pos;
  reg u32 pos32;

  sp = statep[0:25];
  stp = st;
  stp[0] = 0;
  stp[1] = 136;

  sp = _keccak_init_state(sp);
  inp = in1p;
  inlen = in1len;
  () = #spill(in2p, in2len);
  sp, stp = __shake256_absorb_fixed(sp, stp, inp, inlen);
  () = #unspill(in2p, in2len);
  inp = in2p;
  inlen = in2len;
  sp, stp = __shake256_absorb_fixed(sp, stp, inp, inlen);

  statep[0:25] = sp;
  pos = stp[0];
  pos32 = (32u)pos;
  statep.[:u32 200] = pos32;
  statep.[:u32 204] = 0;

  return statep;
}

fn _shake256_absorb_final(reg mut ptr u64[26] statep,
                          reg ui64 inp,
                          reg u64 inlen) -> reg ptr u64[26]
{
  stack u64[2] st;
  reg ptr u64[2] stp;
  reg ptr u64[25] sp;
  reg u64 pos;
  reg u32 pos32;

  sp = statep[0:25];
  stp = st;
  pos32 = statep.[:u32 200];
  pos = (64u)pos32;
  stp[0] = pos;
  stp[1] = 136;

  sp, stp = __shake256_absorb_fixed(sp, stp, inp, inlen);
  sp = __shake256_finalize_fixed(sp, stp);

  statep[0:25] = sp;
  statep.[:u32 200] = 136;
  statep.[:u32 204] = 0;

  return statep;
}

fn _shake256_absorb_thrice_desc(reg mut ptr u64[26] statep,
                                reg const ptr u64[6] descp) -> reg ptr u64[26]
{
  stack u64[2] st;
  reg ptr u64[2] stp;
  reg ptr u64[25] sp;
  reg u64 in1p in2p in3p;
  reg u64 in1len in2len in3len;

  in1p = descp[0];
  in1len = descp[1];
  in2p = descp[2];
  in2len = descp[3];
  in3p = descp[4];
  in3len = descp[5];

  sp = statep[0:25];
  stp = st;
  stp[0] = 0;
  stp[1] = 136;

  sp = _keccak_init_state(sp);
  () = #spill(in2p, in2len, in3p, in3len);
  sp, stp = __shake256_absorb_fixed_addr(sp, stp, in1p, in1len);
  () = #unspill(in2p, in2len, in3p, in3len);
  () = #spill(in3p, in3len);
  sp, stp = __shake256_absorb_fixed_addr(sp, stp, in2p, in2len);
  () = #unspill(in3p, in3len);
  sp, stp = __shake256_absorb_fixed_addr(sp, stp, in3p, in3len);
  sp = __shake256_finalize_fixed(sp, stp);

  statep[0:25] = sp;
  statep.[:u32 200] = 136;
  statep.[:u32 204] = 0;

  return statep;
}
