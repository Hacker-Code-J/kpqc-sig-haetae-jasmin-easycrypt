export
fn sign_round_lk_copy0_mode5_jazz(reg mut ptr u32[2048] z1p,
                                  reg mut ptr u32[2048] z2p,
                                  reg mut ptr u32[HAETAE_N] z10p,
                                  reg const ptr u32[4096] y1p,
