fn __poly_challenge_shake256_finalize(reg mut ptr u64[25] sp,
                                      reg const ptr u64[2] statep)
                                      -> reg ptr u64[25]
{
  reg u64 pos lane t;
  reg u8 shift;
  #[msf] reg u64 ms;

  ms = #init_msf();
  pos = statep[0];
  () = #declassify(pos);
  pos = #protect(pos, ms);
  lane = pos;
  lane >>= 3;
  shift = (8u)pos;
  shift &= 7;
  shift <<= 3;

  t = 0x1f;
  t <<= (shift & 63);
  sp[lane] ^= t;

  t = 1;
  t <<= 63;
  sp[16] ^= t;

  return sp;
}

#[sct = "
{ ptr: public, val: secret } *
{ ptr: public, val: secret } *
public *
public ->
{ ptr: public, val: secret } *
{ ptr: public, val: secret } *
public *
public
"]
inline fn __poly_challenge_shake256_absorb(reg mut ptr u64[25] sp,
                                           reg mut ptr u64[2] statep,
                                           reg u64 inp,
                                           reg u64 inlen) -> reg ptr u64[25],
                                                             reg ptr u64[2],
                                                             reg u64,
                                                             reg u64
{
  reg u64 pos lane t todo;
  reg u8 b shift;
  #[msf] reg u64 ms;
  reg bool cond cond_pos;

  ms = #init_msf();
  pos = statep[0];
  () = #declassify(pos);
  pos = #protect(pos, ms);
  todo = inlen;
  while { cond = todo != 0; } (cond)
  {
    ms = #update_msf(cond, ms);
    cond_pos = pos < 136;
    if (cond_pos)
    {
      ms = #update_msf(cond_pos, ms);
      lane = pos;
      lane >>= 3;
      b = [:u8 inp];
      b = #protect_8(b, ms);
      t = (64u)b;
      shift = (8u)pos;
      shift &= 7;
      shift <<= 3;
      t <<= (shift & 63);
      sp[lane] ^= t;
      inp += 1;
      pos += 1;
      inlen -= 1;
      todo -= 1;
    }
    else
    {
      ms = #update_msf(!cond_pos, ms);
      todo = 0;
    }
  }
  ms = #update_msf(!cond, ms);
  () = #declassify(pos);
  pos = #protect(pos, ms);

  statep[0] = pos;
  return sp, statep, inp, inlen;
}

fn __poly_challenge_absorb_twice(reg mut ptr u64[25] sp,
                                 reg ui64 in1p,
                                 reg u64 in1len,
                                 reg ui64 in2p,
                                 reg u64 in2len) -> reg ptr u64[25]
{
  stack u64[2] st;
  reg ptr u64[2] stp;
  reg u64 inp;
  reg u64 inlen pos;
  #[msf] reg u64 ms;

  ms = #init_msf();
  stp = st;
  stp[0] = 0;
  stp[1] = 136;
  stp = #protect_ptr(stp, ms);

  sp = _keccak_init_state(sp);
  ms = #init_msf();
  inp = (64u)in1p;
  () = #declassify(inp);
  inp = #protect(inp, ms);
  inlen = in1len;
  while (inlen != 0)
  {
    () = #spill(in2p, in2len);
    sp, stp, inp, inlen =
      __poly_challenge_shake256_absorb(sp, stp, inp, inlen);
    () = #unspill(in2p, in2len);
    ms = #init_msf();
    stp = #protect_ptr(stp, ms);
    pos = stp[0];
    () = #declassify(pos);
    pos = #protect(pos, ms);
    if (pos == 136)
    {
      () = #spill(in2p, in2len, inp, inlen, stp);
      sp = _keccakf1600(sp);
      () = #unspill(in2p, in2len, inp, inlen, stp);
      ms = #init_msf();
      stp = #protect_ptr(stp, ms);
      stp[0] = 0;
    }
  }
  inp = (64u)in2p;
  () = #declassify(inp);
  ms = #init_msf();
  inp = #protect(inp, ms);
  inlen = in2len;
  while (inlen != 0)
  {
    sp, stp, inp, inlen =
      __poly_challenge_shake256_absorb(sp, stp, inp, inlen);
    ms = #init_msf();
    stp = #protect_ptr(stp, ms);
    pos = stp[0];
    () = #declassify(pos);
    pos = #protect(pos, ms);
    if (pos == 136)
    {
      () = #spill(inp, inlen, stp);
      sp = _keccakf1600(sp);
      () = #unspill(inp, inlen, stp);
      ms = #init_msf();
      stp = #protect_ptr(stp, ms);
      stp[0] = 0;
    }
  }
  sp = __poly_challenge_shake256_finalize(sp, stp);

  return sp;
}

fn __poly_challenge_squeeze256_136(reg mut ptr u8[136] outp,
                                   reg mut ptr u64[25] sp) -> reg ptr u8[136],
                                                               reg ptr u64[25]
{
  reg u64 i j lane t idx;
  reg u8 b;
  #[msf] reg u64 ms;

  idx = 0;
  () = #spill(outp, idx);
  sp = _keccakf1600(sp);
  () = #unspill(outp, idx);
  ms = #init_msf();
  outp = #protect_ptr(outp, ms);

  i = 0;
  while (i < 136)
  {
    lane = i;
    lane >>= 3;
    t = sp[lane];

    j = 0;
    while (j < 8)
    {
      b = (8u)t;
      outp[idx] = b;
      t >>= 8;
      idx += 1;
      j += 1;
    }

    i += 8;
  }

  return outp, sp;
}

fn __poly_challenge_squeeze256_32(reg mut ptr u8[32] outp,
                                  reg mut ptr u64[25] sp) -> reg ptr u8[32],
                                                              reg ptr u64[25]
{
  reg u64 i j lane t idx;
  reg u8 b;
  #[msf] reg u64 ms;

  idx = 0;
  () = #spill(outp, idx);
  sp = _keccakf1600(sp);
  () = #unspill(outp, idx);
  ms = #init_msf();
  outp = #protect_ptr(outp, ms);

  i = 0;
  while (i < 32)
  {
    lane = i;
    lane >>= 3;
    t = sp[lane];

    j = 0;
    while (j < 8)
    {
      b = (8u)t;
      outp[idx] = b;
      t >>= 8;
      idx += 1;
      j += 1;
    }

    i += 8;
  }

  return outp, sp;
}

fn _poly_challenge_m23(reg mut ptr u32[HAETAE_N] cp,
                       reg ui64 highbitsp,
                       reg u64 highbitslen,
                       reg ui64 mup,
                       reg u64 tau) -> reg ptr u32[HAETAE_N]
{
  stack u64[25] state;
  stack u8[136] buf;
  reg ptr u64[25] sp;
  reg ptr u8[136] bp;
  reg u64 i pos bidx limit mulen;
  reg u32 b old;
  #[msf] reg u64 ms;

  sp = state;
  bp = buf;

  mulen = 32;
  () = #spill(cp, tau);
  sp = __poly_challenge_absorb_twice(sp, highbitsp, highbitslen, mup,
                                     mulen);
  () = #unspill(cp, tau);
  () = #spill(cp, tau);
  bp, sp = __poly_challenge_squeeze256_136(bp, sp);
  () = #unspill(cp, tau);
  ms = #init_msf();
  cp = #protect_ptr(cp, ms);

  cp = _poly_challenge_m23_init(cp);
  i = HAETAE_N;
  i -= tau;
  pos = 0;
  while (i < HAETAE_N)
  {
    if (pos >= 136)
    {
      () = #spill(cp, i);
      bp, sp = __poly_challenge_squeeze256_136(bp, sp);
      () = #unspill(cp, i);
      ms = #init_msf();
      cp = #protect_ptr(cp, ms);
      pos = 0;
    }

    b = (32u)bp[pos];
    pos += 1;
    bidx = (64u)b;
    () = #declassify(bidx);
    ms = #init_msf();
    bidx = #protect(bidx, ms);
    limit = i;
    limit += 1;

    if (bidx < limit)
    {
      old = cp[bidx];
      cp[i] = old;
      cp[bidx] = 1;
      i += 1;
    }
  }

  return cp;
}

fn _poly_challenge_m5(reg mut ptr u32[HAETAE_N] cp,
                      reg ui64 highbitsp,
                      reg u64 highbitslen,
                      reg ui64 mup) -> reg ptr u32[HAETAE_N]
{
  stack u64[25] state;
  stack u8[32] buf;
  reg ptr u64[25] sp;
  reg ptr u8[32] bp;
  reg u64 mulen;
  #[msf] reg u64 ms;

  sp = state;
  bp = buf;

  mulen = 32;
  () = #spill(cp);
  sp = __poly_challenge_absorb_twice(sp, highbitsp, highbitslen, mup,
                                     mulen);
  () = #unspill(cp);
  () = #spill(cp);
  bp, sp = __poly_challenge_squeeze256_32(bp, sp);
  () = #unspill(cp);
  ms = #init_msf();
  cp = #protect_ptr(cp, ms);

  cp = _poly_challenge_m5_frombytes(cp, bp);
  return cp;
}
