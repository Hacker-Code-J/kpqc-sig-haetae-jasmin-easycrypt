{
  z1rndp, z2rndp = _sf_round_lk(z1rndp, z2rndp, z1p, z2p, 1536, 768);
  hp = _sign_make_hint(hp, highp, ayp, z2rndp, 768,
                       HAETAE_HINT_HALF_ALPHA_M23,
                       HAETAE_HINT_LOG_ALPHA_M23,
                       HAETAE_HINT_BOUND_M23);
  return hp, z1rndp, z2rndp;
}

fn _sf_hint_mode5(reg mut ptr u32[2048] hp,
