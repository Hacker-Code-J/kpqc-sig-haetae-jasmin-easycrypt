  return sp, statep;
}

fn __sign_challenge_absorb(reg mut ptr u64[25] sp,
                           reg const ptr u8[1152] highp,
                           reg u64 highlen,
                           reg const ptr u8[32] lsbp,
                           reg const ptr u8[64] mup) -> reg ptr u64[25]
{
  stack u64[2] st;
  reg ptr u64[2] stp;

  stp = st;
  stp[0] = 0;
  stp[1] = 136;

  sp = _keccak_init_state(sp);
  () = #spill(lsbp, mup);
  sp, stp = __sign_challenge_shake256_absorb_buf(sp, stp, highp, highlen);
  () = #unspill(lsbp, mup);
  () = #spill(mup);
  sp, stp = __sign_challenge_shake256_absorb32(sp, stp, lsbp);
  () = #unspill(mup);
  sp, stp = __sign_challenge_shake256_absorb_mu32(sp, stp, mup);
  sp = __poly_challenge_shake256_finalize(sp, stp);

  return sp;
}

fn __sign_challenge_m23(reg mut ptr u32[HAETAE_N] cp,
                        reg const ptr u8[1152] highp,
                        reg u64 highlen,
                        reg const ptr u8[32] lsbp,
                        reg const ptr u8[64] mup,
                        reg u64 tau) -> reg ptr u32[HAETAE_N]
{
  stack u64[25] state;
  stack u8[136] buf;
  reg ptr u64[25] sp;
  reg ptr u8[136] bp;
  reg u64 i pos bidx limit;
  reg u32 b old;
  #[msf] reg u64 ms;

  sp = state;
  bp = buf;
  () = #spill(cp, tau);
  sp = __sign_challenge_absorb(sp, highp, highlen, lsbp, mup);
  () = #unspill(cp, tau);
  () = #spill(cp, tau);
  bp, sp = __poly_challenge_squeeze256_136(bp, sp);
  () = #unspill(cp, tau);
  ms = #init_msf();
  cp = #protect_ptr(cp, ms);

  cp = _poly_challenge_m23_init(cp);
  i = HAETAE_N;
  i -= tau;
  pos = 0;
  while (i < HAETAE_N)
  {
    if (pos >= 136)
    {
      () = #spill(cp, i);
      bp, sp = __poly_challenge_squeeze256_136(bp, sp);
      () = #unspill(cp, i);
      ms = #init_msf();
      cp = #protect_ptr(cp, ms);
      pos = 0;
    }

    b = (32u)bp[pos];
    pos += 1;
    bidx = (64u)b;
    () = #declassify(bidx);
    ms = #init_msf();
    bidx = #protect(bidx, ms);
    limit = i;
    limit += 1;

    if (bidx < limit)
    {
      old = cp[bidx];
      cp[i] = old;
      cp[bidx] = 1;
      i += 1;
    }
  }

  return cp;
}

fn __sign_challenge_m5(reg mut ptr u32[HAETAE_N] cp,
                       reg const ptr u8[1152] highp,
                       reg u64 highlen,
                       reg const ptr u8[32] lsbp,
                       reg const ptr u8[64] mup)
                       -> reg ptr u32[HAETAE_N]
{
  stack u64[25] state;
  stack u8[32] buf;
  reg ptr u64[25] sp;
  reg ptr u8[32] bp;
  #[msf] reg u64 ms;

  sp = state;
  bp = buf;

  () = #spill(cp);
  sp = __sign_challenge_absorb(sp, highp, highlen, lsbp, mup);
  () = #unspill(cp);
  () = #spill(cp);
  bp, sp = __poly_challenge_squeeze256_32(bp, sp);
  () = #unspill(cp);
  ms = #init_msf();
  cp = #protect_ptr(cp, ms);

  cp = _poly_challenge_m5_frombytes(cp, bp);
  return cp;
}

fn _sf_challenge_mode2(reg mut ptr u32[HAETAE_N] cp,
                       reg mut ptr u32[2048] highp,
                       reg const ptr u32[2048] ayp,
                       reg const ptr u32[HAETAE_N] y0p,
                       reg const ptr u8[64] mup) -> reg ptr u32[HAETAE_N],
                                                    reg ptr u32[2048]
{
  stack u8[1152] highbuf;
  stack u8[32] lsb;
  reg ptr u8[1152] highbufp;
  reg ptr u8[32] lsbp;
  reg u64 coeffs highlen k tau;
  #[msf] reg u64 ms;

  coeffs = 512;
  highlen = 576;
  k = 2;
  tau = 58;
  highbufp = highbuf;
  lsbp = lsb;
  () = #spill(cp, ayp, y0p, mup);
  highp = _polyvec_highbits_hint_m23(highp, ayp, coeffs);
  () = #unspill(cp, ayp, y0p, mup);
  highbufp = __sign_challenge_zero_highbuf(highbufp, highlen);
  () = #spill(cp, y0p, mup);
  ms = #init_msf();
  highbufp = #protect_ptr(highbufp, ms);
  highp = #protect_ptr(highp, ms);
  k = #protect(k, ms);
  highbufp = _pack_vec_highbits_m23(highbufp, highp, k);
  () = #unspill(cp, y0p, mup);
  () = #spill(cp, highbufp, mup);
  ms = #init_msf();
  lsbp = #protect_ptr(lsbp, ms);
  y0p = #protect_ptr(y0p, ms);
  lsbp = _pack_poly_lsb(lsbp, y0p);
  () = #unspill(cp, highbufp, mup);
  ms = #init_msf();
  cp = #protect_ptr(cp, ms);
  highbufp = #protect_ptr(highbufp, ms);
  lsbp = #protect_ptr(lsbp, ms);
  mup = #protect_ptr(mup, ms);
  highlen = #protect(highlen, ms);
  tau = #protect(tau, ms);
  cp = __sign_challenge_m23(cp, highbufp, highlen, lsbp, mup, tau);

  return cp, highp;
}

