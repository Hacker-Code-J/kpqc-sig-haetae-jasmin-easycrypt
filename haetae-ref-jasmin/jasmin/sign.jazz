inline fn _sf_round_lk_copy0(reg mut ptr u32[2048] z1p,
                             reg mut ptr u32[2048] z2p,
                             reg mut ptr u32[HAETAE_N] z10p,
                             reg const ptr u32[2048] y1p,
                             reg const ptr u32[2048] y2p,
                             reg u64 lcount,
                             reg u64 kcount) -> reg ptr u32[2048],
                                                 reg ptr u32[2048],
                                                 reg ptr u32[HAETAE_N]
{
  reg u64 i;
  reg u32 a;

  i = 0;
  while (i < lcount)
  {
    a = y1p[i];
    a += HAETAE_LNHALF;
    a >>s= HAETAE_LNBITS;
    z1p[i] = a;
    if (i < HAETAE_N)
    {
      z10p[i] = a;
    }
    i += 1;
  }

  i = 0;
  while (i < kcount)
  {
    a = y2p[i];
    a += HAETAE_LNHALF;
    a >>s= HAETAE_LNBITS;
    z2p[i] = a;
    i += 1;
  }

  return z1p, z2p, z10p;
}

inline fn _sf_round_lk(reg mut ptr u32[2048] z1p,
                       reg mut ptr u32[2048] z2p,
                       reg const ptr u32[2048] y1p,
                       reg const ptr u32[2048] y2p,
                       reg u64 lcount,
                       reg u64 kcount) -> reg ptr u32[2048],
                                           reg ptr u32[2048]
{
  reg u64 i;
  reg u32 a;

  i = 0;
  while (i < lcount)
  {
    a = y1p[i];
    a += HAETAE_LNHALF;
    a >>s= HAETAE_LNBITS;
    z1p[i] = a;
    i += 1;
  }

  i = 0;
  while (i < kcount)
  {
    a = y2p[i];
    a += HAETAE_LNHALF;
    a >>s= HAETAE_LNBITS;
    z2p[i] = a;
    i += 1;
  }

  return z1p, z2p;
}

fn _sf_polyveck_poly_fromcrt_inplace(reg mut ptr u32[2048] wp,
                                     reg const ptr u32[HAETAE_N] vp,
                                     reg u64 count) -> reg ptr u32[2048]
{
  reg u64 k j off idx;
  reg u32 xq x2 mask add r;

  j = 0;
  while (j < HAETAE_N)
  {
    xq = wp[j];
    x2 = vp[j];
    mask = xq;
    mask ^= x2;
    mask &= 1;
    add = 0;
    add -= mask;
    add &= HAETAE_Q;
    r = xq + add;
    wp[j] = r;
    j += 1;
  }

  k = 1;
  off = HAETAE_N;
  while (k < count)
  {
    j = 0;
    while (j < HAETAE_N)
    {
      idx = off;
      idx += j;
      xq = wp[idx];
      mask = xq;
      mask &= 1;
      add = 0;
      add -= mask;
      add &= HAETAE_Q;
      r = xq + add;
      wp[idx] = r;
      j += 1;
    }

    off += HAETAE_N;
    k += 1;
  }

  return wp;
}

fn __sign_challenge_zero_highbuf(reg mut ptr u8[1152] bp,
                                 reg u64 len) -> reg ptr u8[1152]
{
  reg u64 i;

  i = 0;
  while (i < len)
  {
    bp[i] = 0;
    i += 1;
  }

  return bp;
}

fn __sign_challenge_shake256_absorb_buf(reg mut ptr u64[25] sp,
                                        reg mut ptr u64[2] statep,
                                        reg const ptr u8[1152] inp,
                                        reg u64 inlen) -> reg ptr u64[25],
                                                             reg ptr u64[2]
{
  reg u64 pos lane i t;
  reg u8 b shift;
  #[msf] reg u64 ms;

  ms = #init_msf();
  statep = #protect_ptr(statep, ms);
  sp = #protect_ptr(sp, ms);
  inp = #protect_ptr(inp, ms);
  pos = statep[0];
  () = #declassify(pos);
  () = #declassify(inlen);
  pos = #protect(pos, ms);
  inlen = #protect(inlen, ms);
  i = 0;
  while (i < inlen)
  {
    lane = pos;
    lane >>= 3;
    b = inp[i];
    t = (64u)b;
    shift = (8u)pos;
    shift &= 7;
    shift <<= 3;
    t <<= (shift & 63);
    sp[lane] ^= t;
    i += 1;
    pos += 1;

    if (pos == 136)
    {
      () = #spill(statep, inp, inlen, i, pos);
      sp = _keccakf1600(sp);
      () = #unspill(statep, inp, inlen, i, pos);
      () = #declassify(inlen);
      () = #declassify(pos);
      ms = #init_msf();
      statep = #protect_ptr(statep, ms);
      sp = #protect_ptr(sp, ms);
      inp = #protect_ptr(inp, ms);
      inlen = #protect(inlen, ms);
      i = #protect(i, ms);
      pos = #protect(pos, ms);
      pos = 0;
    }
  }

  ms = #init_msf();
  statep = #protect_ptr(statep, ms);
  statep[0] = pos;
  return sp, statep;
}

fn __sign_challenge_shake256_absorb_mu32(reg mut ptr u64[25] sp,
                                         reg mut ptr u64[2] statep,
