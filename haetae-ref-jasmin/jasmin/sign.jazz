fn _sf_round_challenge_mode5(reg mut ptr u32[HAETAE_N] cp,
                             reg mut ptr u32[2048] highp,
                             reg mut ptr u32[2048] ayp,
                             reg mut ptr u32[2048] z1rndp,
                             reg mut ptr u32[2048] z2rndp,
                             reg mut ptr u32[HAETAE_N] z10p,
                             reg const ptr u32[2048] y1p,
                             reg const ptr u32[2048] y2p,
                             reg const ptr u32[8192] a1p,
                             reg const ptr u8[64] mup) -> reg ptr u32[HAETAE_N],
                                                            reg ptr u32[2048],
                                                            reg ptr u32[2048],
                                                            reg ptr u32[2048],
                                                            reg ptr u32[2048],
                                                            reg ptr u32[HAETAE_N]
{
  reg u64 lr kr kcount;
  #[msf] reg u64 ms;

  lr = 7;
  kr = 4;
  kcount = 1024;
  z1rndp, z2rndp, z10p = _sf_round_lk_copy0(z1rndp, z2rndp, z10p, y1p, y2p,
                                            1792, 1024);
  () = #spill(z2rndp, z10p, cp, mup);
  z1rndp = _polyvec_ntt(z1rndp, lr);
  () = #unspill(z2rndp, z10p, cp, mup);
  ayp = _polymat_pointwise_acc(ayp, a1p, z1rndp, kr, lr);
  ayp = _polyvec_invntt(ayp, kr);
  ms = #init_msf();
  ayp = #protect_ptr(ayp, ms);
  z2rndp = #protect_ptr(z2rndp, ms);
  kcount = #protect(kcount, ms);
  ayp, z2rndp = _sign_add_double_z2rnd(ayp, z2rndp, kcount);
  ms = #init_msf();
  ayp = #protect_ptr(ayp, ms);
  z10p = #protect_ptr(z10p, ms);
  kr = #protect(kr, ms);
  ayp = _sf_polyveck_poly_fromcrt_inplace(ayp, z10p, kr);
  ms = #init_msf();
  ayp = #protect_ptr(ayp, ms);
  kcount = #protect(kcount, ms);
  ayp = _polyvec_freeze2q(ayp, kcount);
  ms = #init_msf();
  cp = #protect_ptr(cp, ms);
  highp = #protect_ptr(highp, ms);
  ayp = #protect_ptr(ayp, ms);
  z10p = #protect_ptr(z10p, ms);
  mup = #protect_ptr(mup, ms);
  cp, highp = _sf_challenge_mode5(cp, highp, ayp, z10p, mup);

  return cp, highp, ayp, z1rndp, z2rndp, z10p;
}

fn _sf_add_cs_and_check(reg mut ptr u32[2048] z1p,
                        reg mut ptr u32[2048] z2p,
                        reg mut ptr u32[2048] z1tmpp,
                        reg mut ptr u32[2048] z2tmpp,
                        reg const ptr u32[2048] y1p,
                        reg const ptr u32[2048] y2p,
                        reg const ptr u32[2048] cs1p,
                        reg const ptr u32[2048] cs2p,
                        reg u8 b,
                        reg u64 lcount,
                        reg u64 kcount,
                        reg u64 reject1_bound,
                        reg u64 reject2_bound) -> reg ptr u32[2048],
                                                 reg ptr u32[2048],
                                                 reg ptr u32[2048],
                                                 reg ptr u32[2048],
                                                 reg u64
{
  stack u64 stotal1 stotal2 sgate sreject1_bound sreject2_bound;
  reg u64 i total coeff prod reject1 reject2;
  reg u32 factor twice y cs z tmp;

  sreject1_bound = reject1_bound;
  sreject2_bound = reject2_bound;
  total = (64u)b;
  total &= 2;
  total >>= 1;
  sgate = total;

  twice = (32u)b;
  twice &= 1;
  twice <<= 1;
  factor = 1;
  factor -= twice;

  stotal1 = 0;
  stotal2 = 0;

  i = 0;
  while (i < lcount)
  {
    y = y1p[i];
    cs = cs1p[i];
    cs *= factor;
    cs *= HAETAE_LN;
    z = y;
    z += cs;
    z1p[i] = z;

    coeff = (64s)z;
    prod = coeff * coeff;
    total = stotal1;
    total += prod;
    stotal1 = total;

    tmp = z;
    tmp <<= 1;
    tmp -= y;
    z1tmpp[i] = tmp;

    coeff = (64s)tmp;
    prod = coeff * coeff;
    total = stotal2;
    total += prod;
    stotal2 = total;

    i += 1;
  }

  i = 0;
  while (i < kcount)
  {
    y = y2p[i];
    cs = cs2p[i];
    cs *= factor;
    cs *= HAETAE_LN;
    z = y;
    z += cs;
    z2p[i] = z;

    coeff = (64s)z;
    prod = coeff * coeff;
    total = stotal1;
    total += prod;
    stotal1 = total;

    tmp = z;
    tmp <<= 1;
    tmp -= y;
    z2tmpp[i] = tmp;

    coeff = (64s)tmp;
    prod = coeff * coeff;
    total = stotal2;
    total += prod;
    stotal2 = total;

    i += 1;
  }

  reject1 = sreject1_bound;
  total = stotal1;
  reject1 -= total;
  reject1 >>= 63;
  reject1 &= 1;

  reject2 = stotal2;
  total = sreject2_bound;
  reject2 -= total;
  reject2 >>= 63;
  reject2 &= 1;
  total = sgate;
  reject2 &= total;

  reject1 |= reject2;
  return z1p, z2p, z1tmpp, z2tmpp, reject1;
}

fn _sf_z_check(reg mut ptr u32[2048] z1p,
               reg mut ptr u32[2048] z2p,
               reg mut ptr u32[2048] z1tmpp,
               reg mut ptr u32[2048] z2tmpp,
               reg const ptr u32[2048] y1p,
               reg const ptr u32[2048] y2p,
               reg const ptr u32[HAETAE_N] cp,
               reg const ptr u32[2048] s1p,
               reg const ptr u32[2048] s2p,
               reg u8 b,
               reg u64 lcount,
               reg u64 kcount,
               reg u64 reject1_bound,
               reg u64 reject2_bound) -> reg ptr u32[2048],
                                        reg ptr u32[2048],
                                        reg ptr u32[2048],
                                        reg ptr u32[2048],
                                        reg u64
{
  stack u32[2048] cs1;
  stack u32[2048] cs2;
  stack u32[HAETAE_N] chat;
  reg ptr u32[2048] cs1p cs2p;
  reg ptr u32[HAETAE_N] chatp;
  reg u64 reject lpolys kpolys;

  cs1p = cs1;
  cs2p = cs2;
  chatp = chat;
  cs1p, chatp = _sign_prepare_cs(cs1p, chatp, cp);
  lpolys = lcount;
  lpolys >>= 8;
  kpolys = kcount;
  kpolys >>= 8;
  cs1p = _sign_compute_cs1_tail(cs1p, chatp, s1p, lpolys);
  cs2p = _polyvec_poly_pointwise(cs2p, s2p, chatp, kpolys);
  cs2p = _polyvec_invntt(cs2p, kpolys);
  z1p, z2p, z1tmpp, z2tmpp, reject =
      _sf_add_cs_and_check(z1p, z2p, z1tmpp, z2tmpp, y1p, y2p, cs1p, cs2p,
                           b, lcount, kcount, reject1_bound, reject2_bound);

  return z1p, z2p, z1tmpp, z2tmpp, reject;
}

fn _sf_hint_mode2(reg mut ptr u32[2048] hp,
                  reg mut ptr u32[2048] z1rndp,
                  reg mut ptr u32[2048] z2rndp,
                  reg const ptr u32[2048] highp,
                  reg const ptr u32[2048] ayp,
                  reg const ptr u32[2048] z1p,
                  reg const ptr u32[2048] z2p) -> reg ptr u32[2048],
                                               reg ptr u32[2048],
                                               reg ptr u32[2048]
{
  z1rndp, z2rndp = _sf_round_lk(z1rndp, z2rndp, z1p, z2p, 1024, 512);
  hp = _sign_make_hint(hp, highp, ayp, z2rndp, 512,
                       HAETAE_HINT_HALF_ALPHA_M23,
                       HAETAE_HINT_LOG_ALPHA_M23,
                       HAETAE_HINT_BOUND_M23);
  return hp, z1rndp, z2rndp;
}

