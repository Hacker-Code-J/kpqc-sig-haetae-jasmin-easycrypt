fn _sf_pack_mode2(reg mut ptr u8[2948] sigp,
                  reg const ptr u32[HAETAE_N] cp,
                  reg const ptr u32[2048] z1rndp,
                  reg const ptr u32[2048] hp) -> reg ptr u8[2948],
                                               reg u64
{
  stack u32[2048] lowz;
  stack u32[2048] highz;
  stack u64[1] bad;
  reg ptr u32[2048] lowp highp;
  reg ptr u64[1] badp;
  reg ptr u32[132] hb_esymsp h_esymsp;
  reg u64 reject count;

  count = 1024;
  lowp = lowz;
  highp = highz;
  badp = bad;
  badp[0] = 0;
  lowp, highp = _polyvec_decompose_z1(lowp, highp, z1rndp, count);
  hb_esymsp = jmode2_hb_z1_esyms;
  h_esymsp = jmode2_h_esyms;
  sigp, badp = _pack_sig_full(sigp, badp, cp, lowp, highp, hp, hb_esymsp,
                              h_esymsp, 1474, 4, 1024, 13, 6, 512, 13, 239,
                              132, 7, 416);
  reject = badp[0];
  return sigp, reject;
}

