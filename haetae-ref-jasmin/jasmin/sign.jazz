  ms = #init_msf();
  cp = #protect_ptr(cp, ms);
  highp = #protect_ptr(highp, ms);
  ayp = #protect_ptr(ayp, ms);
  z10p = #protect_ptr(z10p, ms);
  mup = #protect_ptr(mup, ms);
