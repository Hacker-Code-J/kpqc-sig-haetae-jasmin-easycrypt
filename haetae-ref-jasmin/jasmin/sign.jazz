fn _sf_signature_core_mode2(reg mut ptr u8[2948] sigp,
                            reg const ptr u8[2752] skp,
                            reg const ptr u8[32] rndp,
                            reg const ptr u8[64] mup) -> reg ptr u8[2948]
{
  stack u8[64] seedbuf;
  stack u8[32] key;
  stack u8[1] b;
  stack u64[1] counter;
  stack u32[8192] a1;
  stack u32[2048] s1;
  stack u32[2048] s2;
  stack u32[2048] y1;
  stack u32[2048] y2;
  stack u32[2048] z1;
  stack u32[2048] z2;
  stack u32[2048] z1tmp;
  stack u32[2048] z2tmp;
  stack u32[2048] z1rnd;
  stack u32[2048] z2rnd;
  stack u32[2048] highbits;
  stack u32[2048] ay;
  stack u32[2048] h;
  stack u32[HAETAE_N] c;
  stack u32[HAETAE_N] z10;
  reg ptr u8[64] seedbufp;
  reg ptr u8[32] keyp;
  reg ptr u8[1] bp;
  reg ptr u64[1] counterp;
  reg ptr u32[8192] a1p;
  reg ptr u32[2048] s1p s2p y1p y2p z1p z2p z1tmpp z2tmpp;
  reg ptr u32[2048] z1rndp z2rndp highp ayp hp;
  reg ptr u32[HAETAE_N] cp z10p;
  reg u64 reject bad s1polys s2polys lcount kcount b1bound b0bound;
  reg u8 bv;
  #[msf] reg u64 ms;

  seedbufp = seedbuf;
  keyp = key;
  bp = b;
  counterp = counter;
  a1p = a1;
  s1p = s1;
  s2p = s2;
  y1p = y1;
  y2p = y2;
  z1p = z1;
  z2p = z2;
  z1tmpp = z1tmp;
  z2tmpp = z2tmp;
  z1rndp = z1rnd;
  z2rndp = z2rnd;
  highp = highbits;
  ayp = ay;
  hp = h;
  cp = c;
  z10p = z10;
  s1polys = 3;
  s2polys = 2;
  lcount = 1024;
  kcount = 512;
  b1bound = 6496508945891328;
  b0bound = 6505809026482176;

  a1p, s1p, s2p, keyp = _sf_unpack_sk_mode2(a1p, s1p, s2p, keyp, skp);
  seedbufp = _sf_sign_expand_seedbuf(seedbufp, keyp, rndp, mup);
  s1p = _polyvec_ntt(s1p, s1polys);
  s2p = _polyvec_ntt(s2p, s2polys);

  counterp[0] = 0;
  bad = 1;
  while (bad != 0)
  {
    y1p, y2p, bp, counterp = _sf_hyperball_mode2(y1p, y2p, bp, counterp,
                                                 seedbufp);
    cp, highp, ayp, z1rndp, z2rndp, z10p =
        _sf_round_challenge_mode2(cp, highp, ayp, z1rndp, z2rndp, z10p, y1p,
                                  y2p, a1p, mup);
    bv = bp[0];
    z1p, z2p, z1tmpp, z2tmpp, reject =
        _sf_z_check(z1p, z2p, z1tmpp, z2tmpp, y1p, y2p, cp, s1p, s2p, bv,
                    lcount, kcount, b1bound, b0bound);
    () = #declassify(reject);
    ms = #init_msf();
    reject = #protect(reject, ms);
    bad = 1;
    if (reject == 0)
    {
      hp, z1rndp, z2rndp = _sf_hint_mode2(hp, z1rndp, z2rndp, highp, ayp,
                                          z1p, z2p);
      sigp, bad = _sf_pack_mode2(sigp, cp, z1rndp, hp);
    }
    () = #declassify(bad);
    ms = #init_msf();
    bad = #protect(bad, ms);
  }

  return sigp;
}

