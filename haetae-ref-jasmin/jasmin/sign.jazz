fn _sf_round_challenge_mode2(reg mut ptr u32[HAETAE_N] cp,
                             reg mut ptr u32[2048] highp,
                             reg mut ptr u32[2048] ayp,
                             reg mut ptr u32[2048] z1rndp,
                             reg mut ptr u32[2048] z2rndp,
                             reg mut ptr u32[HAETAE_N] z10p,
                             reg const ptr u32[2048] y1p,
                             reg const ptr u32[2048] y2p,
                             reg const ptr u32[8192] a1p,
                             reg const ptr u8[64] mup) -> reg ptr u32[HAETAE_N],
                                                            reg ptr u32[2048],
                                                            reg ptr u32[2048],
                                                            reg ptr u32[2048],
                                                            reg ptr u32[2048],
                                                            reg ptr u32[HAETAE_N]
{
  reg u64 lr kr kcount;
  #[msf] reg u64 ms;

  lr = 4;
  kr = 2;
  kcount = 512;
  z1rndp, z2rndp, z10p = _sf_round_lk_copy0(z1rndp, z2rndp, z10p, y1p, y2p,
                                            1024, 512);
  () = #spill(z2rndp, z10p, cp, mup);
  z1rndp = _polyvec_ntt(z1rndp, lr);
  () = #unspill(z2rndp, z10p, cp, mup);
  ayp = _polymat_pointwise_acc(ayp, a1p, z1rndp, kr, lr);
  ayp = _polyvec_invntt(ayp, kr);
  ms = #init_msf();
  ayp = #protect_ptr(ayp, ms);
  z2rndp = #protect_ptr(z2rndp, ms);
  kcount = #protect(kcount, ms);
  ayp, z2rndp = _sign_add_double_z2rnd(ayp, z2rndp, kcount);
  ms = #init_msf();
  ayp = #protect_ptr(ayp, ms);
  z10p = #protect_ptr(z10p, ms);
  kr = #protect(kr, ms);
  ayp = _sf_polyveck_poly_fromcrt_inplace(ayp, z10p, kr);
  ms = #init_msf();
  ayp = #protect_ptr(ayp, ms);
  kcount = #protect(kcount, ms);
  ayp = _polyvec_freeze2q(ayp, kcount);
  ms = #init_msf();
  cp = #protect_ptr(cp, ms);
  highp = #protect_ptr(highp, ms);
  ayp = #protect_ptr(ayp, ms);
  z10p = #protect_ptr(z10p, ms);
  mup = #protect_ptr(mup, ms);
  cp, highp = _sf_challenge_mode2(cp, highp, ayp, z10p, mup);

  return cp, highp, ayp, z1rndp, z2rndp, z10p;
}

