    sp[lane] ^= t;
    i += 1;
    pos += 1;

    if (pos == 136)
    {
      () = #spill(statep, inp, i, pos);
      sp = _keccakf1600(sp);
      () = #unspill(statep, inp, i, pos);
      () = #declassify(pos);
