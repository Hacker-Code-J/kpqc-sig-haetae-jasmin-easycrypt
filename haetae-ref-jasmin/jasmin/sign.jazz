  return sp, statep;
}

fn __sign_challenge_shake256_absorb32(reg mut ptr u64[25] sp,
                                      reg mut ptr u64[2] statep,
                                      reg const ptr u8[32] inp)
                                      -> reg ptr u64[25],
                                         reg ptr u64[2]
{
  reg u64 pos lane i t;
