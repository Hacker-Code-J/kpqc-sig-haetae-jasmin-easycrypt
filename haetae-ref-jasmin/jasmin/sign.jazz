fn _sf_shake256_absorb_addr(reg mut ptr u64[25] sp,
                            reg mut ptr u64[2] statep,
                            reg u64 inp,
                            reg u64 inlen) -> reg ptr u64[25],
                                              reg ptr u64[2]
{
  reg u64 pos lane t;
  reg u8 b shift;
  #[msf] reg u64 ms;

  ms = #init_msf();
  statep = #protect_ptr(statep, ms);
  sp = #protect_ptr(sp, ms);
  pos = statep[0];
  () = #declassify(pos);
  () = #declassify(inp);
  () = #declassify(inlen);
  pos = #protect(pos, ms);
  inp = #protect(inp, ms);
  inlen = #protect(inlen, ms);
  while (inlen != 0)
  {
    lane = pos;
    lane >>= 3;
    b = [:u8 inp];
    t = (64u)b;
    shift = (8u)pos;
    shift &= 7;
    shift <<= 3;
    t <<= (shift & 63);
    sp[lane] ^= t;
    inp += 1;
    pos += 1;
    inlen -= 1;

    if (pos == 136)
    {
      () = #spill(statep, inp, inlen, pos);
      sp = _keccakf1600(sp);
      () = #unspill(statep, inp, inlen, pos);
      () = #declassify(inp);
      () = #declassify(inlen);
      () = #declassify(pos);
      ms = #init_msf();
      statep = #protect_ptr(statep, ms);
      sp = #protect_ptr(sp, ms);
      inp = #protect(inp, ms);
      inlen = #protect(inlen, ms);
      pos = #protect(pos, ms);
      pos = 0;
    }
  }

  ms = #init_msf();
  statep = #protect_ptr(statep, ms);
  statep[0] = pos;
  return sp, statep;
}

fn _sf_shake256_absorb_sk(reg mut ptr u64[25] sp,
                          reg mut ptr u64[2] statep,
                          reg const ptr u8[2752] skp,
                          reg u64 inlen) -> reg ptr u64[25],
                                            reg ptr u64[2]
{
  reg u64 pos lane t i;
  reg u8 b shift;
  #[msf] reg u64 ms;

  ms = #init_msf();
  statep = #protect_ptr(statep, ms);
  sp = #protect_ptr(sp, ms);
  skp = #protect_ptr(skp, ms);
  pos = statep[0];
  () = #declassify(pos);
  () = #declassify(inlen);
  pos = #protect(pos, ms);
  inlen = #protect(inlen, ms);
  i = 0;
  while (i < inlen)
  {
    lane = pos;
    lane >>= 3;
    b = skp[i];
    t = (64u)b;
    shift = (8u)pos;
    shift &= 7;
    shift <<= 3;
    t <<= (shift & 63);
    sp[lane] ^= t;
    i += 1;
    pos += 1;

    if (pos == 136)
    {
      () = #spill(statep, skp, inlen, i, pos);
      sp = _keccakf1600(sp);
      () = #unspill(statep, skp, inlen, i, pos);
      () = #declassify(inlen);
      () = #declassify(pos);
      ms = #init_msf();
      statep = #protect_ptr(statep, ms);
      sp = #protect_ptr(sp, ms);
      skp = #protect_ptr(skp, ms);
      inlen = #protect(inlen, ms);
      i = #protect(i, ms);
      pos = #protect(pos, ms);
      pos = 0;
    }
  }

  ms = #init_msf();
  statep = #protect_ptr(statep, ms);
  statep[0] = pos;
  return sp, statep;
}

fn _sf_shake256_absorb_pre(reg mut ptr u64[25] sp,
                           reg mut ptr u64[2] statep,
                           reg const ptr u8[257] prep,
                           reg u64 inlen) -> reg ptr u64[25],
                                             reg ptr u64[2]
{
  reg u64 pos lane t i;
  reg u8 b shift;
  #[msf] reg u64 ms;

  ms = #init_msf();
  statep = #protect_ptr(statep, ms);
  sp = #protect_ptr(sp, ms);
  prep = #protect_ptr(prep, ms);
  pos = statep[0];
  () = #declassify(pos);
  () = #declassify(inlen);
  pos = #protect(pos, ms);
  inlen = #protect(inlen, ms);
  i = 0;
  while (i < inlen)
  {
    lane = pos;
    lane >>= 3;
    b = prep[i];
    t = (64u)b;
    shift = (8u)pos;
    shift &= 7;
    shift <<= 3;
    t <<= (shift & 63);
    sp[lane] ^= t;
    i += 1;
    pos += 1;

    if (pos == 136)
    {
      () = #spill(statep, prep, inlen, i, pos);
      sp = _keccakf1600(sp);
      () = #unspill(statep, prep, inlen, i, pos);
      () = #declassify(inlen);
      () = #declassify(pos);
      ms = #init_msf();
      statep = #protect_ptr(statep, ms);
      sp = #protect_ptr(sp, ms);
      prep = #protect_ptr(prep, ms);
      inlen = #protect(inlen, ms);
      i = #protect(i, ms);
      pos = #protect(pos, ms);
      pos = 0;
    }
  }

  ms = #init_msf();
  statep = #protect_ptr(statep, ms);
  statep[0] = pos;
  return sp, statep;
}

fn _sf_shake256_finalize(reg mut ptr u64[25] sp,
                         reg const ptr u64[2] statep) -> reg ptr u64[25]
{
  reg u64 pos lane t;
  reg u8 shift;
  #[msf] reg u64 ms;

  ms = #init_msf();
  statep = #protect_ptr(statep, ms);
  sp = #protect_ptr(sp, ms);
  pos = statep[0];
  () = #declassify(pos);
  pos = #protect(pos, ms);
  lane = pos;
  lane >>= 3;
  shift = (8u)pos;
  shift &= 7;
  shift <<= 3;

  t = 0x1f;
  t <<= (shift & 63);
  sp[lane] ^= t;

  t = 1;
  t <<= 63;
  sp[16] ^= t;

  return sp;
}

#[ct = "outp * secret -> secret * secret"]
fn _sf_shake256_squeeze64(reg mut ptr u8[64] outp,
                          reg mut ptr u64[25] sp) -> reg ptr u8[64],
                                                    reg ptr u64[25]
{
  reg u64 i lane t;
  #[msf] reg u64 ms;

  ms = #init_msf();
  outp = #protect_ptr(outp, ms);
  sp = #protect_ptr(sp, ms);
  i = 0;
  while (i < 64)
  {
    lane = i;
    lane >>= 3;
    t = sp[lane];
    outp.[:u64 i] = t;
    i += 8;
  }

  return outp, sp;
}

#[ct = "mup * public * public * public * public * public * public -> secret"]
fn _sf_mu_rawpre(reg mut ptr u8[64] mup,
                 reg const ptr u8[2752] skp,
                 reg u64 vkbytes,
                 reg u64 preaddr,
                 reg u64 prelen,
                 reg u64 maddr,
                 reg u64 mlen) -> reg ptr u8[64]
{
  stack u64[25] state;
  stack u64[2] st;
  reg ptr u64[25] sp;
  reg ptr u64[2] stp;
  #[msf] reg u64 ms;

  () = #declassify(mup);
  sp = state;
  stp = st;
  stp[0] = 0;
  stp[1] = 136;
  sp = _keccak_init_state(sp);
  () = #spill(mup, preaddr, prelen, maddr, mlen);
  sp, stp = _sf_shake256_absorb_sk(sp, stp, skp, vkbytes);
  () = #unspill(mup, preaddr, prelen, maddr, mlen);
  () = #spill(mup, maddr, mlen);
  sp, stp = _sf_shake256_absorb_addr(sp, stp, preaddr, prelen);
  () = #unspill(mup, maddr, mlen);
  () = #spill(mup);
  sp, stp = _sf_shake256_absorb_addr(sp, stp, maddr, mlen);
  () = #unspill(mup);
  () = #spill(mup);
  sp = _sf_shake256_finalize(sp, stp);
  () = #unspill(mup);
  () = #declassify(mup);
  () = #spill(mup);
  sp = _keccakf1600(sp);
  () = #unspill(mup);
  () = #declassify(mup);
  ms = #init_msf();
  mup = #protect_ptr(mup, ms);
  mup, sp = _sf_shake256_squeeze64(mup, sp);

  return mup;
}

#[ct = "mup * public * public * public * public * public * public -> secret"]
fn _sf_mu_preptr(reg mut ptr u8[64] mup,
                 reg const ptr u8[2752] skp,
                 reg u64 vkbytes,
                 reg const ptr u8[257] prep,
                 reg u64 prelen,
                 reg u64 maddr,
                 reg u64 mlen) -> reg ptr u8[64]
{
  stack u64[25] state;
  stack u64[2] st;
  reg ptr u64[25] sp;
  reg ptr u64[2] stp;
  #[msf] reg u64 ms;

  () = #declassify(mup);
  sp = state;
  stp = st;
  stp[0] = 0;
  stp[1] = 136;
  sp = _keccak_init_state(sp);
  () = #spill(mup, prep, prelen, maddr, mlen);
  sp, stp = _sf_shake256_absorb_sk(sp, stp, skp, vkbytes);
  () = #unspill(mup, prep, prelen, maddr, mlen);
  () = #spill(mup, maddr, mlen);
  sp, stp = _sf_shake256_absorb_pre(sp, stp, prep, prelen);
  () = #unspill(mup, maddr, mlen);
  () = #spill(mup);
  sp, stp = _sf_shake256_absorb_addr(sp, stp, maddr, mlen);
  () = #unspill(mup);
  () = #spill(mup);
  sp = _sf_shake256_finalize(sp, stp);
  () = #unspill(mup);
  () = #declassify(mup);
  () = #spill(mup);
  sp = _keccakf1600(sp);
  () = #unspill(mup);
  () = #declassify(mup);
  ms = #init_msf();
  mup = #protect_ptr(mup, ms);
  mup, sp = _sf_shake256_squeeze64(mup, sp);

  return mup;
}

fn _sf_sign_expand_seedbuf(reg mut ptr u8[64] outp,
                           reg const ptr u8[32] keyp,
                           reg const ptr u8[32] rndp,
                           reg const ptr u8[64] mup) -> reg ptr u8[64]
{
  stack u64[25] s;
  reg ptr u64[25] sp;
  reg u64 pos lane t idx rate;
  reg u8 b shift domain;

  sp = s;
  sp = _keccak_init_state(sp);

  pos = 0;
  while (pos < 32)
  {
    b = keyp[pos];
    lane = pos;
    lane >>= 3;
    t = (64u)b;
    shift = (8u)pos;
    shift &= 7;
    shift <<= 3;
    t <<= (shift & 63);
    sp[lane] ^= t;
    pos += 1;
  }

  idx = 0;
  while (idx < 32)
  {
    b = rndp[idx];
    lane = pos;
    lane >>= 3;
    t = (64u)b;
    shift = (8u)pos;
    shift &= 7;
    shift <<= 3;
    t <<= (shift & 63);
    sp[lane] ^= t;
    pos += 1;
    idx += 1;
  }

  idx = 0;
  while (idx < 64)
  {
    b = mup[idx];
    lane = pos;
    lane >>= 3;
    t = (64u)b;
    shift = (8u)pos;
    shift &= 7;
    shift <<= 3;
    t <<= (shift & 63);
    sp[lane] ^= t;
    pos += 1;
    idx += 1;
  }

  domain = 0x1f;
  rate = 136;
  sp = _keccak_finalize(sp, pos, rate, domain);
  sp = _keccakf1600(sp);

  idx = 0;
  while (idx < 64)
  {
    lane = idx;
    lane >>= 3;
    t = sp[lane];
    shift = (8u)idx;
    shift &= 7;
    shift <<= 3;
    t >>= (shift & 63);
    b = (8u)t;
    outp[idx] = b;
    idx += 1;
  }

  return outp;
}

fn _sf_prepare_pre_raw(reg mut ptr u8[257] prep,
                       reg u64 ctxaddr,
                       reg u64 ctxlen) -> reg ptr u8[257]
{
  reg u64 i dst;
  reg u8 b;

  b = (8u)ctxlen;
  prep[0] = b;
  i = 0;
  while (i < ctxlen)
  {
    b = [:u8 ctxaddr];
    dst = i;
    dst += 1;
    prep[dst] = b;
    ctxaddr += 1;
    i += 1;
  }

  return prep;
}

fn _sf_shake128_init_seed32(reg mut ptr u64[25] sp,
                            reg const ptr u8[2752] seedp,
                            reg u64 nonce) -> reg ptr u64[25]
{
  reg u64 pos lane t n;
  reg u8 b shift;
  inline int k;

  sp = _keccak_init_state(sp);
  n = nonce;
  pos = 0;
  while (pos < 32)
  {
    lane = pos;
    lane >>= 3;
    b = seedp[pos];
    t = (64u)b;
    shift = (8u)pos;
    shift &= 7;
    shift <<= 3;
    t <<= (shift & 63);
    sp[lane] ^= t;
    pos += 1;
  }

  for k = 0 to 2
  {
    lane = pos;
    lane >>= 3;
    b = (8u)n;
    t = (64u)b;
    shift = (8u)pos;
    shift &= 7;
    shift <<= 3;
    t <<= (shift & 63);
    sp[lane] ^= t;
    n >>= 8;
    pos += 1;
  }

  t = 0x1f;
  t <<= 16;
  sp[4] ^= t;
  t = 1;
  t <<= 63;
  sp[20] ^= t;

  return sp;
}

fn _sf_poly_uniform_at_seed32(reg mut ptr u32[8192] ap,
                              reg u64 base,
                              reg const ptr u8[2752] seedp,
                              reg u64 nonce) -> reg ptr u32[8192]
{
  stack u64[25] state;
  stack u8[1024] buf;
  reg ptr u64[25] sp;
  reg ptr u8[1024] bufp;
  reg u64 ctr buflen off i idx;
  reg u8 b;
  #[msf] reg u64 ms;

  sp = state;
  bufp = buf;

  sp = _sf_shake128_init_seed32(sp, seedp, nonce);
  off = 0;
  () = #spill(ap, base);
  bufp, sp = __poly_sample_squeeze128(bufp, off, sp);
  () = #declassify(bufp);
  off = 168;
  bufp, sp = __poly_sample_squeeze128(bufp, off, sp);
  () = #declassify(bufp);
  off = 336;
  bufp, sp = __poly_sample_squeeze128(bufp, off, sp);
  () = #declassify(bufp);
  off = 504;
  bufp, sp = __poly_sample_squeeze128(bufp, off, sp);
  () = #declassify(bufp);
  () = #unspill(ap, base);

  ctr = 0;
  buflen = 672;
  ap, ctr = __poly_uniform_consume(ap, base, ctr, bufp, buflen);
  () = #declassify(ctr);
  () = #declassify(base);
  ms = #init_msf();
  ap = #protect_ptr(ap, ms);
  bufp = #protect_ptr(bufp, ms);
  base = #protect(base, ms);
  ctr = #protect(ctr, ms);

  while (ctr < HAETAE_N)
  {
    off = buflen;
    off &= 1;

    i = 0;
    while (i < off)
    {
      idx = buflen;
      idx -= off;
      idx += i;
      b = bufp[idx];
      bufp[i] = b;
      i += 1;
    }

    () = #spill(ap, base, ctr, buflen);
    bufp, sp = __poly_sample_squeeze128(bufp, off, sp);
  () = #declassify(bufp);
    () = #unspill(ap, base, ctr, buflen);
    buflen = 168;
    buflen += off;
    () = #declassify(base);
    () = #declassify(ctr);
    () = #declassify(buflen);
    ms = #init_msf();
    ap = #protect_ptr(ap, ms);
    bufp = #protect_ptr(bufp, ms);
    base = #protect(base, ms);
    ctr = #protect(ctr, ms);
    buflen = #protect(buflen, ms);
    ap, ctr = __poly_uniform_consume(ap, base, ctr, bufp, buflen);
    () = #declassify(ctr);
    ms = #init_msf();
    ap = #protect_ptr(ap, ms);
    bufp = #protect_ptr(bufp, ms);
    ctr = #protect(ctr, ms);
  }

  return ap;
}

fn _sf_polymatkl_expand_with_vecA_seed32(reg mut ptr u32[8192] matp,
                                         reg const ptr u8[2752] seedp,
                                         reg u64 rows,
                                         reg u64 cols,
                                         reg u64 m) -> reg ptr u32[8192]
{
  reg u64 i j base nonce;
  #[msf] reg u64 ms;

  i = 0;
  base = 0;
  while (i < rows)
  {
    nonce = rows;
    nonce <<= 8;
    nonce += m;
    nonce += i;

    () = #spill(seedp, rows, cols, m, i, base);
    matp = _sf_poly_uniform_at_seed32(matp, base, seedp, nonce);
    () = #unspill(seedp, rows, cols, m, i, base);
    () = #declassify(rows);
    () = #declassify(cols);
    () = #declassify(m);
    () = #declassify(i);
    () = #declassify(base);
    ms = #init_msf();
    matp = #protect_ptr(matp, ms);
    seedp = #protect_ptr(seedp, ms);
    rows = #protect(rows, ms);
    cols = #protect(cols, ms);
    m = #protect(m, ms);
    i = #protect(i, ms);
    base = #protect(base, ms);
    base += HAETAE_N;

    j = 0;
    while (j < m)
    {
      nonce = i;
      nonce <<= 8;
      nonce += j;

      () = #spill(seedp, rows, cols, m, i, j, base);
      matp = _sf_poly_uniform_at_seed32(matp, base, seedp, nonce);
      () = #unspill(seedp, rows, cols, m, i, j, base);
      () = #declassify(rows);
      () = #declassify(cols);
      () = #declassify(m);
      () = #declassify(i);
      () = #declassify(j);
      () = #declassify(base);
      ms = #init_msf();
      matp = #protect_ptr(matp, ms);
      seedp = #protect_ptr(seedp, ms);
      rows = #protect(rows, ms);
      cols = #protect(cols, ms);
      m = #protect(m, ms);
      i = #protect(i, ms);
      j = #protect(j, ms);
      base = #protect(base, ms);
      j += 1;
      base += HAETAE_N;
    }

    i += 1;
  }

  return matp;
}

fn _sf_polymatkl_expand_seed32(reg mut ptr u32[8192] matp,
                               reg const ptr u8[2752] seedp,
                               reg u64 rows,
                               reg u64 cols) -> reg ptr u32[8192]
{
  reg u64 i j base nonce rowbase m;
  #[msf] reg u64 ms;

  m = cols;
  m -= 1;
  i = 0;
  rowbase = 0;
  while (i < rows)
  {
    j = 0;
    while (j < m)
    {
      nonce = i;
      nonce <<= 8;
      nonce += j;

      base = rowbase;
      base += j;
      base += 1;
      base *= HAETAE_N;

      () = #spill(seedp, rows, cols, m, i, j, rowbase);
      matp = _sf_poly_uniform_at_seed32(matp, base, seedp, nonce);
      () = #unspill(seedp, rows, cols, m, i, j, rowbase);
      () = #declassify(rows);
      () = #declassify(cols);
      () = #declassify(m);
      () = #declassify(i);
      () = #declassify(j);
      () = #declassify(rowbase);
      ms = #init_msf();
      matp = #protect_ptr(matp, ms);
      seedp = #protect_ptr(seedp, ms);
      rows = #protect(rows, ms);
      cols = #protect(cols, ms);
      m = #protect(m, ms);
      i = #protect(i, ms);
      j = #protect(j, ms);
      rowbase = #protect(rowbase, ms);
      j += 1;
    }

    rowbase += cols;
    i += 1;
  }

  return matp;
}

fn _sf_unpack_sk_mode2(reg mut ptr u32[8192] matp,
                       reg mut ptr u32[2048] s1p,
                       reg mut ptr u32[2048] s2p,
                       reg mut ptr u8[32] keyp,
                       reg const ptr u8[2752] skp) -> reg ptr u32[8192],
                                                     reg ptr u32[2048],
                                                     reg ptr u32[2048],
                                                     reg ptr u8[32]
{
  stack u32[2048] b;
  reg ptr u32[2048] bp;
  reg u64 count kr lr mr vkbr;
  #[msf] reg u64 ms;

  kr = 2;
  lr = 4;
  mr = 3;
  vkbr = 992;
  bp = b;
  bp = __unpack_vk_m23_coeffs(bp, skp, kr);
  () = #spill(bp, s1p, s2p, keyp, skp);
  matp = _sf_polymatkl_expand_with_vecA_seed32(matp, skp, kr, lr, mr);
  () = #unspill(bp, s1p, s2p, keyp, skp);
  bp = b;
  matp = _polymatkl_double(matp, kr, lr);
  count = kr;
  count *= HAETAE_N;
  bp = _polyvec_double(bp, count);
  bp = __polyvec_sub_left_inplace(bp, matp, lr, kr);
  bp = _polyvec_double(bp, count);
  () = #spill(matp, s1p, s2p, keyp, skp);
  bp = _polyvec_ntt(bp, kr);
  () = #unspill(matp, s1p, s2p, keyp, skp);
  ms = #init_msf();
  matp = #protect_ptr(matp, ms);
  bp = #protect_ptr(bp, ms);
  kr = #protect(kr, ms);
  lr = #protect(lr, ms);
  matp = _polymat_set_first_column(matp, bp, kr, lr);
  s1p, s2p, keyp = _unpack_sk_m23(s1p, s2p, keyp, skp, vkbr, mr, kr);

  return matp, s1p, s2p, keyp;
}

fn _sf_unpack_sk_mode3(reg mut ptr u32[8192] matp,
                       reg mut ptr u32[2048] s1p,
                       reg mut ptr u32[2048] s2p,
                       reg mut ptr u8[32] keyp,
                       reg const ptr u8[2752] skp) -> reg ptr u32[8192],
                                                     reg ptr u32[2048],
                                                     reg ptr u32[2048],
                                                     reg ptr u8[32]
{
  stack u32[2048] b;
  reg ptr u32[2048] bp;
  reg u64 count kr lr mr vkbr;
  #[msf] reg u64 ms;

  kr = 3;
  lr = 6;
  mr = 5;
  vkbr = 1472;
  bp = b;
  bp = __unpack_vk_m23_coeffs(bp, skp, kr);
  () = #spill(bp, s1p, s2p, keyp, skp);
  matp = _sf_polymatkl_expand_with_vecA_seed32(matp, skp, kr, lr, mr);
  () = #unspill(bp, s1p, s2p, keyp, skp);
  bp = b;
  matp = _polymatkl_double(matp, kr, lr);
  count = kr;
  count *= HAETAE_N;
  bp = _polyvec_double(bp, count);
  bp = __polyvec_sub_left_inplace(bp, matp, lr, kr);
  bp = _polyvec_double(bp, count);
  () = #spill(matp, s1p, s2p, keyp, skp);
  bp = _polyvec_ntt(bp, kr);
  () = #unspill(matp, s1p, s2p, keyp, skp);
  ms = #init_msf();
  matp = #protect_ptr(matp, ms);
  bp = #protect_ptr(bp, ms);
  kr = #protect(kr, ms);
  lr = #protect(lr, ms);
  matp = _polymat_set_first_column(matp, bp, kr, lr);
  s1p, s2p, keyp = _unpack_sk_m23(s1p, s2p, keyp, skp, vkbr, mr, kr);

  return matp, s1p, s2p, keyp;
}

fn _sf_unpack_sk_mode5(reg mut ptr u32[8192] matp,
                       reg mut ptr u32[2048] s1p,
                       reg mut ptr u32[2048] s2p,
                       reg mut ptr u8[32] keyp,
                       reg const ptr u8[2752] skp) -> reg ptr u32[8192],
                                                     reg ptr u32[2048],
                                                     reg ptr u32[2048],
                                                     reg ptr u8[32]
{
  stack u32[2048] b;
  reg ptr u32[2048] bp;
  reg u64 kr lr mr vkbr;
  #[msf] reg u64 ms;

  kr = 4;
  lr = 7;
  mr = 6;
  vkbr = 2080;
  bp = b;
  bp = __unpack_vk_m5_coeffs(bp, skp, kr);
  () = #spill(bp, s1p, s2p, keyp, skp);
  matp = _sf_polymatkl_expand_seed32(matp, skp, kr, lr);
  () = #unspill(bp, s1p, s2p, keyp, skp);
  bp = b;
  matp = _polymatkl_double(matp, kr, lr);
  ms = #init_msf();
  matp = #protect_ptr(matp, ms);
  bp = #protect_ptr(bp, ms);
  kr = #protect(kr, ms);
  lr = #protect(lr, ms);
  matp = _polymat_set_first_column(matp, bp, kr, lr);
  s1p, s2p, keyp = _unpack_sk_m5(s1p, s2p, keyp, skp, vkbr, mr, kr);

  return matp, s1p, s2p, keyp;
}

fn _sf_shake256_init_seed64(reg mut ptr u64[25] sp,
                            reg const ptr u8[64] seedp,
                            reg u64 nonce) -> reg ptr u64[25]
{
  reg u64 pos lane t n;
  reg u8 b shift;
  inline int k;

  sp = _keccak_init_state(sp);
  n = nonce;
  pos = 0;
  while (pos < 64)
  {
    lane = pos;
    lane >>= 3;
    b = seedp[pos];
    t = (64u)b;
    shift = (8u)pos;
    shift &= 7;
    shift <<= 3;
    t <<= (shift & 63);
    sp[lane] ^= t;
    pos += 1;
  }

  for k = 0 to 2
  {
    lane = pos;
    lane >>= 3;
    b = (8u)n;
    t = (64u)b;
    shift = (8u)pos;
    shift &= 7;
    shift <<= 3;
    t <<= (shift & 63);
    sp[lane] ^= t;
    n >>= 8;
    pos += 1;
  }

  t = 0x1f;
  t <<= 16;
  sp[8] ^= t;
  t = 1;
  t <<= 63;
  sp[16] ^= t;

  return sp;
}

fn _sf_sample_gauss_N_full_at(reg mut ptr u64[4096] rp,
                              reg mut ptr u8[512] signsp,
                              reg mut ptr u64[2] sqsump,
                              reg const ptr u8[64] seedp,
                              reg u64 nonce,
                              reg u64 len,
                              reg u64 sampleoff,
                              reg u64 signoff) -> reg ptr u64[4096],
                                                  reg ptr u8[512],
                                                  reg ptr u64[2]
{
  stack u64[25] state;
  stack u8[8192] buf;
  stack u64[1] coefcnt_buf;
  reg ptr u64[25] sp;
  reg ptr u8[8192] bufp;
  reg ptr u64[1] coefcntp;
  reg u64 block off signbytes bytecnt counts total got firstflag remaining;
  reg u64 dont bufoff outoff;
  #[msf] reg u64 ms;

  sp = state;
  bufp = buf;
  coefcntp = coefcnt_buf;

  sp = _sf_shake256_init_seed64(sp, seedp, nonce);

  block = 0;
  off = 0;
  while (block < 32)
  {
    () = #spill(rp, signsp, sqsump, block, off, len, sampleoff, signoff);
    bufp, sp = __sample_full_squeeze256(bufp, off, sp);
    () = #declassify(bufp);
    () = #unspill(rp, signsp, sqsump, block, off, len, sampleoff, signoff);
    () = #declassify(block);
    () = #declassify(off);
    () = #declassify(len);
    () = #declassify(sampleoff);
    () = #declassify(signoff);
    ms = #init_msf();
    bufp = #protect_ptr(bufp, ms);
    sp = #protect_ptr(sp, ms);
    rp = #protect_ptr(rp, ms);
    signsp = #protect_ptr(signsp, ms);
    sqsump = #protect_ptr(sqsump, ms);
    block = #protect(block, ms);
    off = #protect(off, ms);
    len = #protect(len, ms);
    sampleoff = #protect(sampleoff, ms);
    signoff = #protect(signoff, ms);
    off += 136;
    block += 1;
  }

  signbytes = len;
  signbytes >>= 3;
  signsp = __sample_gauss_N_copy_signs_at(signsp, bufp, signbytes, signoff);

  bytecnt = 4352;
  bytecnt -= signbytes;
  counts = bytecnt;
  counts <<= 32;
  counts |= len;

  dont = len;
  while (dont >= HAETAE_N)
  {
    dont -= HAETAE_N;
  }

  bufoff = signbytes;
  outoff = sampleoff;
  () = #spill(signsp, sp, len, bytecnt, signbytes, dont, sampleoff, signoff);
  rp, sqsump, coefcntp = __sample_gauss_at(rp, sqsump, coefcntp, bufp,
                                           counts, dont, bufoff, outoff);
  () = #unspill(signsp, sp, len, bytecnt, signbytes, dont, sampleoff, signoff);
  ms = #init_msf();
  rp = #protect_ptr(rp, ms);
  signsp = #protect_ptr(signsp, ms);
  sqsump = #protect_ptr(sqsump, ms);
  coefcntp = #protect_ptr(coefcntp, ms);
  sp = #protect_ptr(sp, ms);
  len = #protect(len, ms);
  bytecnt = #protect(bytecnt, ms);
  signbytes = #protect(signbytes, ms);
  dont = #protect(dont, ms);
  sampleoff = #protect(sampleoff, ms);
  signoff = #protect(signoff, ms);
  got = coefcntp[0];
  () = #declassify(got);
  got = #protect(got, ms);
  total = got;
  firstflag = 1;

  while (total < len)
  {
    off = bytecnt;
    while (off >= 17)
    {
      off -= 17;
    }

    bufp = _sample_gauss_N_carry(bufp, bytecnt, signbytes, firstflag, off);

    () = #spill(rp, signsp, sqsump, bytecnt, signbytes, firstflag, len, total,
                dont, off, sampleoff, signoff);
    bufp, sp = __sample_full_squeeze256(bufp, off, sp);
    () = #declassify(bufp);
    () = #unspill(rp, signsp, sqsump, bytecnt, signbytes, firstflag, len, total,
                  dont, off, sampleoff, signoff);
    () = #declassify(bytecnt);
    () = #declassify(signbytes);
    () = #declassify(firstflag);
    () = #declassify(len);
    () = #declassify(total);
    () = #declassify(dont);
    () = #declassify(off);
    () = #declassify(sampleoff);
    () = #declassify(signoff);
    ms = #init_msf();
    bufp = #protect_ptr(bufp, ms);
    sp = #protect_ptr(sp, ms);
    rp = #protect_ptr(rp, ms);
    signsp = #protect_ptr(signsp, ms);
    sqsump = #protect_ptr(sqsump, ms);
    bytecnt = #protect(bytecnt, ms);
    signbytes = #protect(signbytes, ms);
    firstflag = #protect(firstflag, ms);
    len = #protect(len, ms);
    total = #protect(total, ms);
    dont = #protect(dont, ms);
    off = #protect(off, ms);
    sampleoff = #protect(sampleoff, ms);
    signoff = #protect(signoff, ms);

    bytecnt = 136;
    bytecnt += off;
    remaining = len;
    remaining -= total;
    counts = bytecnt;
    counts <<= 32;
    counts |= remaining;
    bufoff = 0;
    outoff = sampleoff;
    outoff += total;
    () = #spill(signsp, sp, len, bytecnt, signbytes, firstflag, total, dont,
                sampleoff, signoff);
    rp, sqsump, coefcntp = __sample_gauss_at(rp, sqsump, coefcntp, bufp,
                                             counts, dont, bufoff, outoff);
    () = #unspill(signsp, sp, len, bytecnt, signbytes, firstflag, total, dont,
                  sampleoff, signoff);
    ms = #init_msf();
    rp = #protect_ptr(rp, ms);
    signsp = #protect_ptr(signsp, ms);
    sqsump = #protect_ptr(sqsump, ms);
    coefcntp = #protect_ptr(coefcntp, ms);
    sp = #protect_ptr(sp, ms);
    len = #protect(len, ms);
    bytecnt = #protect(bytecnt, ms);
    signbytes = #protect(signbytes, ms);
    firstflag = #protect(firstflag, ms);
    total = #protect(total, ms);
    dont = #protect(dont, ms);
    sampleoff = #protect(sampleoff, ms);
    signoff = #protect(signoff, ms);
    got = coefcntp[0];
    () = #declassify(got);
    got = #protect(got, ms);
    total += got;
    firstflag = 0;
  }

  return rp, signsp, sqsump;
}

fn _sf_hyperball_b_raw(reg mut ptr u8[1] bp,
                       reg const ptr u8[64] seedp,
                       reg u64 nonce) -> reg ptr u8[1]
{
  stack u64[25] s;
  reg ptr u64[25] sp;
  reg u64 i lane t;
  reg u8 shift b;

  sp = s;
  sp = _keccak_init_state(sp);

  i = 0;
  while (i < 64)
  {
    b = seedp[i];
    t = (64u)b;
    lane = i;
    lane >>= 3;
    shift = (8u)i;
    shift &= 7;
    shift <<= 3;
    t <<= (shift & 63);
    sp[lane] ^= t;
    i += 1;
  }

  b = (8u)nonce;
  t = (64u)b;
  sp[8] ^= t;
  nonce >>= 8;
  b = (8u)nonce;
  t = (64u)b;
  t <<= 8;
  sp[8] ^= t;

  t = 0x1f;
  t <<= 16;
  sp[8] ^= t;
  t = 1;
  t <<= 63;
  sp[16] ^= t;

  sp = _keccakf1600(sp);
  t = sp[0];
  b = (8u)t;
  bp[0] = b;

  return bp;
}

fn _sf_scale_and_check(reg mut ptr u32[2048] y1p,
                       reg mut ptr u32[2048] y2p,
                       reg const ptr u64[4096] samplesp,
                       reg const ptr u8[512] signsp,
                       reg const ptr u64[2] scalep,
                       reg u64 lcount,
                       reg u64 total,
                       reg u64 bound) -> reg ptr u32[2048],
                                         reg ptr u32[2048],
                                         reg u64
{
  reg u64 counts kcount norm accepted;
  #[msf] reg u64 ms;

  () = #declassify(lcount);
  () = #declassify(total);
  () = #declassify(bound);
  ms = #init_msf();
  lcount = #protect(lcount, ms);
  total = #protect(total, ms);
  bound = #protect(bound, ms);

  counts = total;
  counts <<= 32;
  counts |= lcount;
  y1p, y2p = _polyfixveclk_scale_samples(y1p, y2p, samplesp, signsp, scalep,
                                         counts);

  kcount = total;
  kcount -= lcount;
  norm = _polyfixveclk_sqnorm2_2048(y1p, lcount, y2p, kcount);
  () = #declassify(norm);
  ms = #init_msf();
  norm = #protect(norm, ms);
  bound = #protect(bound, ms);
  accepted = 0;
  if (norm <= bound)
  {
    accepted = 1;
  }

  return y1p, y2p, accepted;
}

fn _sf_hyperball_full(reg mut ptr u32[2048] y1p,
                      reg mut ptr u32[2048] y2p,
                      reg mut ptr u8[1] bp,
                      reg mut ptr u64[1] counterp,
                      reg const ptr u8[64] seedp,
                      reg u64 lcount,
                      reg u64 kcount,
                      reg u64 scale_const,
                      reg u64 bound_const,
                      reg u64 cube0,
                      reg u64 cube1,
                      reg u64 three0,
                      reg u64 three1) -> reg ptr u32[2048],
                                            reg ptr u32[2048],
                                            reg ptr u8[1],
                                            reg ptr u64[1]
{
  stack u64[4096] samples;
  stack u8[512] signs;
  stack u64[2] sqsum;
  stack u64[2] invsqrt;
  stack u64[2] start_cube;
  stack u64[2] start_three;
  reg ptr u64[4096] samplesp;
  reg ptr u8[512] signsp;
  reg ptr u64[2] sqsump invsqrtp cubep threep;
  reg u64 ni accepted idx total len sampleoff signoff scale lcoeffs tcoeffs;
  #[msf] reg u64 ms;

  samplesp = samples;
  signsp = signs;
  sqsump = sqsum;
  invsqrtp = invsqrt;
  cubep = start_cube;
  threep = start_three;

  cubep[0] = cube0;
  cubep[1] = cube1;
  threep[0] = three0;
  threep[1] = three1;

  ni = counterp[0];
  () = #spill(counterp);
  accepted = 0;
  while (accepted == 0)
  {
    sqsump[0] = 0;
    sqsump[1] = 0;

    len = HAETAE_N;
    len += 1;
    sampleoff = 0;
    signoff = 0;
    samplesp, signsp, sqsump = _sf_sample_gauss_N_full_at(samplesp, signsp,
                                                          sqsump, seedp, ni,
                                                          len, sampleoff,
                                                          signoff);
    ni += 1;

    sampleoff = HAETAE_N;
    signoff = 32;
    samplesp, signsp, sqsump = _sf_sample_gauss_N_full_at(samplesp, signsp,
                                                          sqsump, seedp, ni,
                                                          len, sampleoff,
                                                          signoff);
    ni += 1;

    total = lcount;
    total += kcount;
    idx = 2;
    while (idx < total)
    {
      len = HAETAE_N;
      sampleoff = idx;
      sampleoff *= HAETAE_N;
      signoff = idx;
      signoff *= 32;
      samplesp, signsp, sqsump = _sf_sample_gauss_N_full_at(samplesp, signsp,
                                                            sqsump, seedp, ni,
                                                            len, sampleoff,
                                                            signoff);
      ni += 1;
      idx += 1;
    }

    sqsump = _fixpoint_half_round(sqsump);
    invsqrtp = _fixpoint_newton_invsqrt(invsqrtp, sqsump, cubep, threep);
    scale = scale_const;
    sqsump = _fixpoint_mul_high(sqsump, invsqrtp, scale);

    lcoeffs = lcount;
    lcoeffs <<= 8;
    tcoeffs = total;
    tcoeffs <<= 8;
    y1p, y2p, accepted = _sf_scale_and_check(y1p, y2p, samplesp, signsp,
                                             sqsump, lcoeffs, tcoeffs,
                                             bound_const);
  }

  bp = _sf_hyperball_b_raw(bp, seedp, ni);
  () = #unspill(counterp);
  () = #declassify(counterp);
  ms = #init_msf();
  counterp = #protect_ptr(counterp, ms);
  counterp[0] = ni;

  return y1p, y2p, bp, counterp;
}

#[ct = "public * public * bp * counterp * seedp -> public * public * {bp, counterp, seedp} * counterp"]
export
fn _sf_hyperball_mode2(reg mut ptr u32[2048] y1p,
                       reg mut ptr u32[2048] y2p,
                       reg mut ptr u8[1] bp,
                       reg mut ptr u64[1] counterp,
                       reg const ptr u8[64] seedp) -> reg ptr u32[2048],
                                                     reg ptr u32[2048],
                                                     reg ptr u8[1],
                                                     reg ptr u64[1]
{
  reg u64 lcount kcount scale bound cube0 cube1 three0 three1;
  #[msf] reg u64 ms;

  lcount = 4;
  kcount = 2;
  scale = 2643021496320;
  bound = 6505809026482176;
  cube0 = 0x770077e2e41a;
  cube1 = 0x1162;
  three0 = 0x693861ad937b;
  three1 = 0x9caa56;
  ms = #init_msf();
  y1p = #protect_ptr(y1p, ms);
  y2p = #protect_ptr(y2p, ms);
  bp = #protect_ptr(bp, ms);
  counterp = #protect_ptr(counterp, ms);
  seedp = #protect_ptr(seedp, ms);
  lcount = #protect(lcount, ms);
  kcount = #protect(kcount, ms);
  scale = #protect(scale, ms);
  bound = #protect(bound, ms);
  cube0 = #protect(cube0, ms);
  cube1 = #protect(cube1, ms);
  three0 = #protect(three0, ms);
  three1 = #protect(three1, ms);
  y1p, y2p, bp, counterp = _sf_hyperball_full(
      y1p, y2p, bp, counterp, seedp, lcount, kcount, scale, bound, cube0,
      cube1, three0, three1);
  return y1p, y2p, bp, counterp;
}

