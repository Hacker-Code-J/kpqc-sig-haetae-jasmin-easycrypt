  }
  while (i < 2948)
  {
    dstp[(64u)i] = 0;
    i += 1;
  }

  return dstp;
}

inline fn _api_copy_2080_to_raw(reg ui64 dstp,
                         reg const ptr u8[2080] srcp,
                         reg ui64 len) -> reg ui64
{
  reg ui64 i addr;
  reg u8 b;

  i = 0;
  while (i < len)
  {
    b = srcp[(64u)i];
    addr = dstp;
    addr += i;
    [:u8 (64u)addr] = b;
    i += 1;
  }

  return dstp;
}

inline fn _api_copy_2752_to_raw(reg ui64 dstp,
