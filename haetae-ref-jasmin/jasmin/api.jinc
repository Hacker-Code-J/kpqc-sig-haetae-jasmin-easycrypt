inline fn _api_copy_raw_to_32(reg mut ptr u8[32] dstp,
                       reg ui64 srcp) -> reg ptr u8[32]
{
  reg ui64 i addr;
  reg u8 b;

  i = 0;
  while (i < 32)
  {
    addr = srcp;
    addr += i;
    b = [:u8 (64u)addr];
    dstp[(64u)i] = b;
    i += 1;
  }

  return dstp;
}

inline fn _api_copy_raw_to_2752_prefix(reg mut ptr u8[2752] dstp,
                                reg ui64 srcp,
                                reg ui64 len) -> reg ptr u8[2752]
{
  reg ui64 i addr;
  reg u8 b;

  i = 0;
  while (i < len)
  {
    addr = srcp;
    addr += i;
    b = [:u8 (64u)addr];
    dstp[(64u)i] = b;
    i += 1;
  }
  while (i < 2752)
  {
    dstp[(64u)i] = 0;
    i += 1;
  }

  return dstp;
}

inline fn _api_copy_raw_to_2948_prefix(reg mut ptr u8[2948] dstp,
                                reg ui64 srcp,
                                reg ui64 len) -> reg ptr u8[2948]
