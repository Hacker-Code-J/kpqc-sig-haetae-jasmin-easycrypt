fn cryptolab_haetae_mode2_verify(reg ui64 sigu,
                                 reg ui64 siglen,
                                 reg ui64 mu,
                                 reg ui64 mlen,
                                 reg ui64 ctxu,
                                 reg ui64 ctxlen,
                                 reg ui64 vku) -> reg u64
{
  reg u64 reject r prelen flag;

  if (ctxlen > 255)
  {
    r = _api_reject();
  }
  else
  {
    prelen = (64u)ctxlen;
    flag = 1;
    flag <<= 63;
    prelen += flag;
    reject = _api_verify_mode2_raw(sigu, (64u)siglen, (64u)mu, (64u)mlen,
                                   (64u)ctxu, prelen, vku);
    if (reject == 0) { r = 0; } else { r = _api_reject(); }
  }
  return r;
}

