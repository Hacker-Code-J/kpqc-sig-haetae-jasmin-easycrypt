fn cryptolab_haetae_mode5_verify_internal(reg ui64 sigu,
                                          reg ui64 siglen,
                                          reg ui64 mu,
                                          reg ui64 mlen,
                                          reg ui64 preu,
                                          reg ui64 prelen,
                                          reg ui64 vku) -> reg u64
