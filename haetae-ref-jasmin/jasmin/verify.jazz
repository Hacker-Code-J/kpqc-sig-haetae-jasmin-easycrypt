fn cryptolab_haetae_mode2_open(reg ui64 mu,
                               reg ui64 mlenu,
                               reg ui64 smu,
                               reg ui64 smlen,
                               reg ui64 ctxu,
                               reg ui64 ctxlen,
                               reg ui64 vku) -> reg u64
{
  reg ui64 msgu mlen;
  reg u64 reject r prelen flag badlen;

  if (smlen < 1474)
  {
    badlen = 0; badlen -= 1;
    [:u64 (64u)mlenu] = badlen;
    mu = _api_zero_raw(mu, smlen);
    r = _api_reject();
  }
  else
  {
    mlen = smlen;
    mlen -= 1474;
    msgu = smu;
    msgu += 1474;
    if (ctxlen > 255)
    {
      reject = 1;
    }
    else
    {
      prelen = (64u)ctxlen;
      flag = 1;
      flag <<= 63;
      prelen += flag;
      reject = _api_verify_mode2_raw(smu, 1474, (64u)msgu, (64u)mlen,
                                     (64u)ctxu, prelen, vku);
    }
    if (reject == 0)
    {
      [:u64 (64u)mlenu] = (64u)mlen;
      mu = _api_copy_raw_to_raw(mu, msgu, mlen);
      r = 0;
    }
    else
    {
      badlen = 0; badlen -= 1;
      [:u64 (64u)mlenu] = badlen;
      mu = _api_zero_raw(mu, smlen);
      r = _api_reject();
    }
  }
  return r;
}

fn cryptolab_haetae_mode3_open(reg ui64 mu,
                               reg ui64 mlenu,
                               reg ui64 smu,
                               reg ui64 smlen,
                               reg ui64 ctxu,
                               reg ui64 ctxlen,
                               reg ui64 vku) -> reg u64
{
  reg ui64 msgu mlen;
  reg u64 reject r prelen flag badlen;

  if (smlen < 2349)
  {
    badlen = 0; badlen -= 1;
    [:u64 (64u)mlenu] = badlen;
    mu = _api_zero_raw(mu, smlen);
    r = _api_reject();
  }
  else
  {
    mlen = smlen;
    mlen -= 2349;
    msgu = smu;
    msgu += 2349;
    if (ctxlen > 255)
    {
      reject = 1;
    }
    else
    {
      prelen = (64u)ctxlen;
      flag = 1;
      flag <<= 63;
      prelen += flag;
      reject = _api_verify_mode3_raw(smu, 2349, (64u)msgu, (64u)mlen,
                                     (64u)ctxu, prelen, vku);
    }
    if (reject == 0)
    {
      [:u64 (64u)mlenu] = (64u)mlen;
      mu = _api_copy_raw_to_raw(mu, msgu, mlen);
      r = 0;
    }
    else
    {
      badlen = 0; badlen -= 1;
      [:u64 (64u)mlenu] = badlen;
      mu = _api_zero_raw(mu, smlen);
      r = _api_reject();
    }
  }
  return r;
}

fn cryptolab_haetae_mode5_open(reg ui64 mu,
                               reg ui64 mlenu,
                               reg ui64 smu,
                               reg ui64 smlen,
                               reg ui64 ctxu,
                               reg ui64 ctxlen,
