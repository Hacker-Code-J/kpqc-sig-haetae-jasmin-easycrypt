  return reject;
}

fn cryptolab_haetae_mode2_verify_internal(reg ui64 sigu,
                                          reg ui64 siglen,
                                          reg ui64 mu,
                                          reg ui64 mlen,
                                          reg ui64 preu,
                                          reg ui64 prelen,
                                          reg ui64 vku) -> reg u64
{
  reg u64 reject r;

  reject = _api_verify_mode2_raw(sigu, (64u)siglen, (64u)mu, (64u)mlen,
                                 (64u)preu, (64u)prelen, vku);
  if (reject == 0) { r = 0; } else { r = _api_reject(); }
  return r;
}

fn cryptolab_haetae_mode3_verify_internal(reg ui64 sigu,
                                          reg ui64 siglen,
                                          reg ui64 mu,
