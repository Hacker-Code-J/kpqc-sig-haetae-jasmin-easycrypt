inline fn _api_verify_mode5_raw(reg ui64 sigu,
                         reg u64 siglen,
                         reg u64 mu,
                         reg u64 mlen,
                         reg u64 preu,
                         reg u64 prelen,
                         reg ui64 vku) -> reg u64
{
  stack u8[2948] sig;
  stack u8[2752] vk;
  stack u64[5] desc;
