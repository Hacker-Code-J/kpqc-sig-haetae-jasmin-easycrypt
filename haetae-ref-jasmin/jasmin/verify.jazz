  reg ptr u8[2752] vkp;
  reg ptr u64[5] descp;
  reg u64 reject;

  if (siglen != 2948)
  {
    reject = 1;
  }
  else
  {
    sigp = sig;
    vkp = vk;
    descp = desc;
    sigp = _api_copy_raw_to_2948_prefix(sigp, sigu, 2948);
    vkp = _api_copy_raw_to_2752_prefix(vkp, vku, 2080);
    descp[0] = (64u)vku;
    descp[1] = (64u)preu;
    descp[2] = prelen;
    descp[3] = (64u)mu;
    descp[4] = (64u)mlen;
    reject = sign_verify_internal_mode5_jazz(sigp, 2948, vkp, vku, descp);
