#[ct = "public * public * public -> public"]
export
fn cryptolab_haetae_mode2_keypair_internal(reg ui64 vku,
                                           reg ui64 sku,
                                           reg ui64 seedu) -> reg u64
{
  stack u8[2080] vk;
  stack u8[2752] sk;
  stack u8[32] seed;
  reg ptr u8[2080] vkp;
  reg ptr u8[2752] skp;
  reg ptr u8[32] seedp;
  reg u64 r vkua skua seedua;
  #[msf] reg u64 ms;

  vkp = vk;
  skp = sk;
  seedp = seed;
  vkua = (64u)vku;
  skua = (64u)sku;
  seedua = (64u)seedu;
  () = #declassify(vku);
  () = #declassify(sku);
  () = #declassify(seedu);
  () = #declassify(vkua);
  () = #declassify(skua);
  () = #declassify(seedua);
  ms = #init_msf();
  vkua = #protect(vkua, ms);
  skua = #protect(skua, ms);
  seedua = #protect(seedua, ms);
  seedp = __kp_api_copy_addr_to_32(seedp, seedua);
  vkp, skp = crypto_sign_keypair_internal_mode2_jazz(vkp, skp, seedp);
  vkua = __kp_api_copy_2080_to_addr(vkua, vkp, 992);
  skua = __kp_api_copy_2752_to_addr(skua, skp, 1408);
  r = 0;
  return r;
}

