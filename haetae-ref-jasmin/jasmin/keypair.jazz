inline fn __kp_api_copy_addr_to_32(reg mut ptr u8[32] dstp,
                                   reg u64 srcp) -> reg ptr u8[32]
{
  reg u64 i addr;
  reg u8 b;

  i = 0;
  while (i < 32)
  {
    addr = srcp;
    addr += i;
    b = [:u8 addr];
    dstp[i] = b;
    i += 1;
  }

  return dstp;
}

inline fn __kp_api_copy_2080_to_addr(reg u64 dstp,
                                     reg const ptr u8[2080] srcp,
                                     reg u64 len) -> reg u64
{
  reg u64 i addr;
  reg u8 b;

  i = 0;
  while (i < len)
  {
    b = srcp[i];
    addr = dstp;
    addr += i;
    [:u8 addr] = b;
    i += 1;
  }

  return dstp;
}

inline fn __kp_api_copy_2752_to_addr(reg u64 dstp,
                                     reg const ptr u8[2752] srcp,
                                     reg u64 len) -> reg u64
{
  reg u64 i addr;
  reg u8 b;

  i = 0;
  while (i < len)
  {
    b = srcp[i];
    addr = dstp;
    addr += i;
    [:u8 addr] = b;
    i += 1;
  }

  return dstp;
}

fn __kp_shake128_init_seedbuf(reg mut ptr u64[25] sp,
                              reg const ptr u8[128] seedp,
                              reg u64 seedoff,
                              reg u64 nonce) -> reg ptr u64[25]
{
  reg u64 pos idx lane t n;
  reg u8 b shift;
  inline int k;

  sp = _keccak_init_state(sp);

  n = nonce;
  pos = 0;
  while (pos < 32)
  {
    idx = seedoff;
    idx += pos;
    b = seedp[idx];
    lane = pos;
    lane >>= 3;
    t = (64u)b;
    shift = (8u)pos;
    shift &= 7;
    shift <<= 3;
    t <<= (shift & 63);
    sp[lane] ^= t;
    pos += 1;
  }

  for k = 0 to 2
  {
    lane = pos;
    lane >>= 3;
    b = (8u)n;
    t = (64u)b;
    shift = (8u)pos;
    shift &= 7;
    shift <<= 3;
    t <<= (shift & 63);
    sp[lane] ^= t;
    n >>= 8;
    pos += 1;
  }

  t = 0x1f;
  t <<= 16;
  sp[4] ^= t;
  t = 1;
  t <<= 63;
  sp[20] ^= t;

  return sp;
}

fn __kp_shake256_init_seedbuf(reg mut ptr u64[25] sp,
                              reg const ptr u8[128] seedp,
                              reg u64 seedoff,
                              reg u64 nonce) -> reg ptr u64[25]
{
  reg u64 pos idx lane t n;
  reg u8 b shift;
  inline int k;

  sp = _keccak_init_state(sp);

  n = nonce;
  pos = 0;
  while (pos < 64)
  {
    idx = seedoff;
    idx += pos;
    b = seedp[idx];
    lane = pos;
    lane >>= 3;
    t = (64u)b;
    shift = (8u)pos;
    shift &= 7;
    shift <<= 3;
    t <<= (shift & 63);
    sp[lane] ^= t;
    pos += 1;
  }

  for k = 0 to 2
  {
    lane = pos;
    lane >>= 3;
    b = (8u)n;
    t = (64u)b;
    shift = (8u)pos;
    shift &= 7;
    shift <<= 3;
    t <<= (shift & 63);
    sp[lane] ^= t;
    n >>= 8;
    pos += 1;
  }

  t = 0x1f;
  t <<= 16;
  sp[8] ^= t;
  t = 1;
  t <<= 63;
  sp[16] ^= t;

  return sp;
}

fn __kp_poly_uniform_consume_poly(reg mut ptr u32[HAETAE_N] ap,
                                  reg u64 ctr,
                                  reg ptr u8[1024] bp,
                                  reg u64 buflen) -> reg ptr u32[HAETAE_N],
                                                     reg u64
{
  reg u64 pos rem live;
  reg u8 byte;
  reg u32 t u;
  #[msf] reg u64 ms;

  pos = 0;
  live = 1;
  while (live != 0)
  {
    if (ctr >= HAETAE_N)
    {
      live = 0;
    }
    else
    {
      rem = buflen;
      rem -= pos;
      if (rem < 2)
      {
        live = 0;
      }
      else
      {
        byte = bp[pos];
        t = (32u)byte;
        pos += 1;
        byte = bp[pos];
        u = (32u)byte;
        pos += 1;
        u <<= 8;
        t |= u;
        () = #declassify(t);
        ms = #init_msf();
        t = #protect_32(t, ms);

        if (t < HAETAE_Q)
        {
          ap[ctr] = t;
          ctr += 1;
        }
      }
    }
  }

  return ap, ctr;
}

fn __kp_poly_uniform_eta_consume_poly(reg mut ptr u32[HAETAE_N] ap,
                                      reg u64 ctr,
                                      reg ptr u8[1024] bp,
                                      reg u64 buflen) -> reg ptr u32[HAETAE_N],
                                                         reg u64
{
  reg u64 pos live;
  reg u8 byte;
  reg u32 t r;
  #[msf] reg u64 ms;

  pos = 0;
  live = 1;
  while (live != 0)
  {
    if (ctr >= HAETAE_N)
    {
      live = 0;
    }
    else
    {
      if (pos < buflen)
      {
        byte = bp[pos];
        t = (32u)byte;
        pos += 1;
        () = #declassify(t);
        ms = #init_msf();
        t = #protect_32(t, ms);

        if (t < 243)
        {
          r = __poly_sample_mod3(t);
          ap[ctr] = r;
          ctr += 1;

          if (ctr < HAETAE_N)
          {
            t *= 171;
            t >>= 9;
            r = __poly_sample_mod3(t);
            ap[ctr] = r;
            ctr += 1;
          }

          if (ctr < HAETAE_N)
          {
            t *= 171;
            t >>= 9;
            r = __poly_sample_mod3_leq26(t);
            ap[ctr] = r;
            ctr += 1;
          }

          if (ctr < HAETAE_N)
          {
            t *= 171;
            t >>= 9;
            r = __poly_sample_mod3_leq8(t);
            ap[ctr] = r;
            ctr += 1;
          }

          if (ctr < HAETAE_N)
          {
            t *= 171;
            t >>= 9;
            r = t;
            r >>= 1;
            r *= 3;
            t -= r;
            ap[ctr] = t;
            ctr += 1;
          }
        }
      }
      else
      {
        live = 0;
      }
    }
  }

  return ap, ctr;
}

fn __kp_poly_uniform_consume_2048(reg mut ptr u32[2048] ap,
                                  reg u64 base,
                                  reg u64 ctr,
                                  reg ptr u8[1024] bp,
                                  reg u64 buflen) -> reg ptr u32[2048],
                                                     reg u64
{
  reg u64 pos rem live idx;
  reg u8 byte;
  reg u32 t u;
  #[msf] reg u64 ms;

  pos = 0;
  live = 1;
  while (live != 0)
  {
    if (ctr >= HAETAE_N)
    {
      live = 0;
    }
    else
    {
      rem = buflen;
      rem -= pos;
      if (rem < 2)
      {
        live = 0;
      }
      else
      {
        byte = bp[pos];
        t = (32u)byte;
        pos += 1;
        byte = bp[pos];
        u = (32u)byte;
        pos += 1;
        u <<= 8;
        t |= u;
        () = #declassify(t);
        ms = #init_msf();
        t = #protect_32(t, ms);

        if (t < HAETAE_Q)
        {
          idx = base;
          idx += ctr;
          ap[idx] = t;
          ctr += 1;
        }
      }
    }
  }

  return ap, ctr;
}

fn __kp_poly_uniform_eta_consume_2048(reg mut ptr u32[2048] ap,
                                      reg u64 base,
                                      reg u64 ctr,
                                      reg ptr u8[1024] bp,
                                      reg u64 buflen) -> reg ptr u32[2048],
                                                         reg u64
{
  reg u64 pos live idx;
  reg u8 byte;
  reg u32 t r;
  #[msf] reg u64 ms;

  pos = 0;
  live = 1;
  while (live != 0)
  {
    if (ctr >= HAETAE_N)
    {
      live = 0;
    }
    else
    {
      if (pos < buflen)
      {
        byte = bp[pos];
        t = (32u)byte;
        pos += 1;
        () = #declassify(t);
        ms = #init_msf();
        t = #protect_32(t, ms);

        if (t < 243)
        {
          r = __poly_sample_mod3(t);
          idx = base;
          idx += ctr;
          ap[idx] = r;
          ctr += 1;

          if (ctr < HAETAE_N)
          {
            t *= 171;
            t >>= 9;
            r = __poly_sample_mod3(t);
            idx = base;
            idx += ctr;
            ap[idx] = r;
            ctr += 1;
          }

          if (ctr < HAETAE_N)
          {
            t *= 171;
            t >>= 9;
            r = __poly_sample_mod3_leq26(t);
            idx = base;
            idx += ctr;
            ap[idx] = r;
            ctr += 1;
          }

          if (ctr < HAETAE_N)
          {
            t *= 171;
            t >>= 9;
            r = __poly_sample_mod3_leq8(t);
            idx = base;
            idx += ctr;
            ap[idx] = r;
            ctr += 1;
          }

          if (ctr < HAETAE_N)
          {
            t *= 171;
            t >>= 9;
            r = t;
            r >>= 1;
            r *= 3;
            t -= r;
            idx = base;
            idx += ctr;
            ap[idx] = t;
            ctr += 1;
          }
        }
      }
      else
      {
        live = 0;
      }
    }
  }

  return ap, ctr;
}

fn _kp_poly_uniform_at_seedbuf(reg mut ptr u32[HAETAE_N] ap,
                               reg const ptr u8[128] seedp,
                               reg u64 seedoff,
                               reg u64 nonce) -> reg ptr u32[HAETAE_N]
{
  stack u64[25] state;
  stack u8[1024] buf;
  reg ptr u64[25] sp;
  reg ptr u8[1024] bufp;
  reg u64 ctr buflen off i idx;
  reg u8 b;
  #[msf] reg u64 ms;

  sp = state;
  bufp = buf;

  sp = __kp_shake128_init_seedbuf(sp, seedp, seedoff, nonce);
  off = 0;
  () = #spill(ap);
  bufp, sp = __poly_sample_squeeze128(bufp, off, sp);
  () = #declassify(bufp);
  off = 168;
  bufp, sp = __poly_sample_squeeze128(bufp, off, sp);
  () = #declassify(bufp);
  off = 336;
  bufp, sp = __poly_sample_squeeze128(bufp, off, sp);
  () = #declassify(bufp);
  off = 504;
  bufp, sp = __poly_sample_squeeze128(bufp, off, sp);
  () = #declassify(bufp);
  () = #unspill(ap);

  ctr = 0;
  buflen = 672;
  ap, ctr = __kp_poly_uniform_consume_poly(ap, ctr, bufp, buflen);
  () = #declassify(ctr);
  ms = #init_msf();
  ap = #protect_ptr(ap, ms);
  bufp = #protect_ptr(bufp, ms);
  ctr = #protect(ctr, ms);

  while (ctr < HAETAE_N)
  {
    off = buflen;
    off &= 1;

    i = 0;
    while (i < off)
    {
      idx = buflen;
      idx -= off;
      idx += i;
      b = bufp[idx];
      bufp[i] = b;
      i += 1;
    }

    () = #spill(ap, ctr, buflen);
    bufp, sp = __poly_sample_squeeze128(bufp, off, sp);
  () = #declassify(bufp);
    () = #unspill(ap, ctr, buflen);
    buflen = 168;
    buflen += off;
    () = #declassify(ctr);
    () = #declassify(buflen);
    ms = #init_msf();
    ap = #protect_ptr(ap, ms);
    bufp = #protect_ptr(bufp, ms);
    ctr = #protect(ctr, ms);
    buflen = #protect(buflen, ms);
    ap, ctr = __kp_poly_uniform_consume_poly(ap, ctr, bufp, buflen);
    () = #declassify(ctr);
    ms = #init_msf();
    ap = #protect_ptr(ap, ms);
    bufp = #protect_ptr(bufp, ms);
    ctr = #protect(ctr, ms);
  }

  return ap;
}

fn _kp_poly_uniform_at_seedbuf_8192(reg mut ptr u32[8192] ap,
                                    reg u64 base,
                                    reg const ptr u8[128] seedp,
                                    reg u64 seedoff,
                                    reg u64 nonce) -> reg ptr u32[8192]
{
  stack u64[25] state;
  stack u8[1024] buf;
  reg ptr u64[25] sp;
  reg ptr u8[1024] bufp;
  reg u64 ctr buflen off i idx;
  reg u8 b;
  #[msf] reg u64 ms;

  sp = state;
  bufp = buf;

  sp = __kp_shake128_init_seedbuf(sp, seedp, seedoff, nonce);
  off = 0;
  () = #spill(ap, base);
  bufp, sp = __poly_sample_squeeze128(bufp, off, sp);
  () = #declassify(bufp);
  off = 168;
  bufp, sp = __poly_sample_squeeze128(bufp, off, sp);
  () = #declassify(bufp);
  off = 336;
  bufp, sp = __poly_sample_squeeze128(bufp, off, sp);
  () = #declassify(bufp);
  off = 504;
  bufp, sp = __poly_sample_squeeze128(bufp, off, sp);
  () = #declassify(bufp);
  () = #unspill(ap, base);

  ctr = 0;
  buflen = 672;
  ap, ctr = __poly_uniform_consume(ap, base, ctr, bufp, buflen);
  () = #declassify(ctr);
  () = #declassify(base);
  ms = #init_msf();
  ap = #protect_ptr(ap, ms);
  bufp = #protect_ptr(bufp, ms);
  base = #protect(base, ms);
  ctr = #protect(ctr, ms);

  while (ctr < HAETAE_N)
  {
    off = buflen;
    off &= 1;

    i = 0;
    while (i < off)
    {
      idx = buflen;
      idx -= off;
      idx += i;
      b = bufp[idx];
      bufp[i] = b;
      i += 1;
    }

    () = #spill(ap, base, ctr, buflen);
    bufp, sp = __poly_sample_squeeze128(bufp, off, sp);
  () = #declassify(bufp);
    () = #unspill(ap, base, ctr, buflen);
    buflen = 168;
    buflen += off;
    () = #declassify(base);
    () = #declassify(ctr);
    () = #declassify(buflen);
    ms = #init_msf();
    ap = #protect_ptr(ap, ms);
    bufp = #protect_ptr(bufp, ms);
    base = #protect(base, ms);
    ctr = #protect(ctr, ms);
    buflen = #protect(buflen, ms);
    ap, ctr = __poly_uniform_consume(ap, base, ctr, bufp, buflen);
    () = #declassify(ctr);
    ms = #init_msf();
    ap = #protect_ptr(ap, ms);
    bufp = #protect_ptr(bufp, ms);
    ctr = #protect(ctr, ms);
  }

  return ap;
}

