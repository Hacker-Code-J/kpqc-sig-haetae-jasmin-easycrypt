  seedp = _api_copy_raw_to_32(seedp, seedu);
  vkp, skp = crypto_sign_keypair_internal_mode2_jazz(vkp, skp, seedp);
  vku = _api_copy_2080_to_raw(vku, vkp, 992);
  sku = _api_copy_2752_to_raw(sku, skp, 1408);
  r = 0;
  return r;
}

