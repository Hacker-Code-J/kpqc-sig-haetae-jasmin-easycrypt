                                           reg ui64 sku,
                                           reg ui64 seedu) -> reg u64
{
  stack u8[2080] vk;
  stack u8[2752] sk;
  stack u8[32] seed;
  reg ptr u8[2080] vkp;
  reg ptr u8[2752] skp;
  reg ptr u8[32] seedp;
  reg u64 r;

  vkp = vk;
  skp = sk;
