}

#[ct = "vkp * skp -> secret * secret"]
export
fn crypto_sign_keypair_mode2_jazz(reg mut ptr u8[2080] vkp,
                                  reg mut ptr u8[2752] skp)
                                  -> reg ptr u8[2080],
                                     reg ptr u8[2752]
{
  stack u8[32] seed;
  reg ptr u8[32] seedp;
  #[msf] reg u64 ms;

  seedp = seed;
  ms = #init_msf();
  vkp = #protect_ptr(vkp, ms);
  skp = #protect_ptr(skp, ms);
  seedp = #protect_ptr(seedp, ms);
  seedp = #randombytes(seedp);
